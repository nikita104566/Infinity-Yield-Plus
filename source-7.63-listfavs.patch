+addcmd('listfavs',{'showfavs','favlist'},function(args, speaker)
+    local list = favCmds or {}
+    if type(list) ~= "table" or #list == 0 then
+        notify(T("favListTitle"), T("favListEmpty"))
+        return
+    end
+    local shown = {}
+    local n = #list
+    if n > 12 then n = 12 end
+    for i = 1, n do
+        shown[i] = tostring(list[i])
+    end
+    local extra = #list - n
+    local body = table.concat(shown, ", ")
+    if extra > 0 then
+        body = body .. " +" .. tostring(extra)
+    end
+    notify(T("favListTitle") .. " (" .. tostring(#list) .. ")", body)
+end)
+
