+addcmd('favcmd', {'pincmd', 'starcmd'}, function(args, speaker)
+    local raw = getstring(1)
+    if type(raw) ~= "string" then raw = "" end
+    raw = raw:match("^%s*(.-)%s*$") or ""
+    if raw == "" then
+        notify(T("favorites"), T("favNeedName"))
+        return
+    end
+    local token = raw:match("^(%S+)") or raw
+    local found = findCmd(token)
+    if not found then
+        notify(T("favorites"), T("favUnknown") .. ": " .. token)
+        return
+    end
+    local key = cmdPrimaryKey(found.NAME)
+    local isFav = FavCmds.is(key)
+    if isFav then
+        notify(T("favorites"), T("addFavorite") .. ": " .. key)
+        return
+    end
+    FavCmds.toggle(key)
+end)
+
+addcmd('unfavcmd', {'unstarcmd'}, function(args, speaker)
+    local raw = getstring(1)
+    if type(raw) ~= "string" then raw = "" end
+    raw = raw:match("^%s*(.-)%s*$") or ""
+    if raw == "" then
+        notify(T("favorites"), T("favNeedName"))
+        return
+    end
+    local token = raw:match("^(%S+)") or raw
+    local found = findCmd(token)
+    local key = found and cmdPrimaryKey(found.NAME) or cmdPrimaryKey(token)
+    if key == "" then
+        notify(T("favorites"), T("favUnknown") .. ": " .. token)
+        return
+    end
+    local isFav = FavCmds.is(key)
+    if not isFav then
+        notify(T("favorites"), T("removeFavorite") .. ": " .. key)
+        return
+    end
+    FavCmds.toggle(key)
+end)
+
+addcmd('listfav', {'favs', 'showfav'}, function(args, speaker)
+    if type(favCmds) ~= "table" or #favCmds == 0 then
+        notify(T("favorites"), T("favEmptyList"))
+        return
+    end
+    notify(T("favorites"), table.concat(favCmds, ", "))
+end)
+
 addcmd('removecmd',{'deletecmd'},function(args, speaker)
     removecmd(args[1])
 end)
