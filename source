function checkTT()
    if not (Holder and Holder.Parent and Tooltip) then
        return
    end
    if introPlaying or SettingsOpen or not Holder.Visible or not CMDsF or not CMDsF.Visible then
        hideHelper(true)
        return
    end

    -- Right gutter / scrollbar: allow scrolling without opening the helper
    local listPos = CMDsF.AbsolutePosition
    local listSize = CMDsF.AbsoluteSize
    local gutter = math.max(SCROLL_GUTTER, (CMDsF.ScrollBarThickness or 6) + 10)
    if IYMouse.X >= (listPos.X + listSize.X - gutter) and IYMouse.X <= (listPos.X + listSize.X + 2)
        and IYMouse.Y >= listPos.Y and IYMouse.Y <= (listPos.Y + listSize.Y) then
        hideHelper(true)
        return
    end

    local mx, my = IYMouse.X, IYMouse.Y
    local function pointIn(gui)
        if not (gui and gui.Parent) then return false end
        local p = gui.AbsolutePosition
        local s = gui.AbsoluteSize
        return mx >= p.X and mx <= p.X + s.X and my >= p.Y and my <= p.Y + s.Y
    end

    local hovered
    for _, btn in ipairs(visibleCmdButtons) do
        if btn and btn.Visible and btn:GetAttribute("Title") and pointIn(btn) then
            hovered = btn
            break
        end
    end
    if not hovered then
        for _, child in pairs(CMDsF:GetChildren()) do
            if child:IsA("TextButton") and child.Visible and child:GetAttribute("Title") and pointIn(child) then
                hovered = child
                break
            end
        end
    end
    if not hovered then
        local ok, guisAtPosition = pcall(function()
            return COREGUI:GetGuiObjectsAtPosition(mx, my)
        end)
        if ok and type(guisAtPosition) == "table" then
            for _, gui in pairs(guisAtPosition) do
                if gui:IsA("TextButton") and gui.Parent == CMDsF and gui.Visible and gui:GetAttribute("Title") then
                    hovered = gui
                    break
                end
                if gui.Name == "Label" and gui.Parent and gui.Parent:IsA("TextButton") and gui.Parent.Parent == CMDsF then
                    local rowBtn = gui.Parent
                    if rowBtn.Visible and rowBtn:GetAttribute("Title") then
                        hovered = rowBtn
                        break
                    end
                end
            end
        end
    end

    if hovered then
        showHelper(hovered:GetAttribute("Title") or hovered.Text, hovered:GetAttribute("Desc"))
        return
    end
    if HelperFavBtn and HelperFavBtn.Visible and pointIn(HelperFavBtn) then
        return
    end
    hideHelper()
end

