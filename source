		if not ok or type(data) ~= "table" then
			notify(T("autoStudio"), T("eeImportBad"))
			return
		end
		local anyKnown, malformed = false, false
		for eventName, list in pairs(data) do
			if events[eventName] and type(list) == "table" then
				anyKnown = true
				if #list > 500 then malformed = true break end
				for _, raw in ipairs(list) do
					if type(raw) ~= "table" or type(raw[1]) ~= "string" then
						malformed = true
						break
					end
				end
				if malformed then break end
			end
		end
		if not anyKnown or malformed then
			notify(T("autoStudio"), T("eeImportBad"))
			return
		end
		pushUndo()
		loadData(data)
		importFrame.Visible = false
		markEdited()
		updateCountLabel()
		refreshList()
		notify(T("autoStudio"), T("eeImported"))
