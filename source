-- Infinity Yield Plus 7.63
-- One loadstring: load the 7.50 core, then polish command-list rows.
currentVersion = "7.63"

local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"

local raw
do
	local ok, body = pcall(function()
		return game:HttpGet(CORE)
	end)
	if not ok or type(body) ~= "string" or #body < 10000 then
		error("Infinity Yield Plus: failed to load core source")
	end
	raw = body
end

raw = raw:gsub("currentVersion = '7.50'", "currentVersion = '7.63'", 1)

local OLD_FMT = "function formatCmdRich%(text%)\n\tif not text or text == \"\" then\n\t\treturn \"\"\n\tend"

local NEW_FMT = [[function formatCmdRich(text, opts)
	if not text or text == "" then
		return ""
	end]]

if not raw:find(OLD_FMT) then
	error("Infinity Yield Plus: core formatCmdRich not found")
end
raw = raw:gsub(OLD_FMT, NEW_FMT:gsub("%%", "%%%%"), 1)

local OLD_MID = [[	aliases = aliases or ""
	local html = "<font color=\"#B8B4CC\">·</font> <font color=\"#F4F4F8\">" .. primary .. "</font>"
	if aliases ~= "" then
		html = html .. "<font color=\"#7A778C\"> " .. aliases .. "</font>"
	end]]

local NEW_MID = [[	aliases = aliases or ""
	opts = opts or {}
	local html = ""
	if opts.fav then
		html = "<font color=\"#FFD666\">★</font> "
	end
	html = html .. "<font color=\"#B8B4CC\">·</font> <font color=\"#F4F4F8\">" .. primary .. "</font>"
	if aliases ~= "" and opts.showAliases then
		html = html .. "<font color=\"#7A778C\"> " .. aliases .. "</font>"
	end]]

if not raw:find(OLD_MID, 1, true) then
	error("Infinity Yield Plus: core formatCmdRich body not found")
end
raw = raw:gsub(OLD_MID:gsub("(%W)", "%%%1"), NEW_MID:gsub("%%", "%%%%"), 1)

local OLD_APPLY = [[			label.Text = formatCmdRich(text)]]

local NEW_APPLY = [[			local fav = false
			if type(isFavoriteCmd) == "function" then
				local okFav, v = pcall(isFavoriteCmd, btn:GetAttribute("Title") or text)
				fav = okFav and v and true or false
			end
			label.Text = formatCmdRich(text, { fav = fav })]]

if not raw:find(OLD_APPLY, 1, true) then
	error("Infinity Yield Plus: core applyCmdRowText call not found")
end
raw = raw:gsub(OLD_APPLY:gsub("(%W)", "%%%1"), NEW_APPLY:gsub("%%", "%%%%"), 1)

local OLD_FAV = [[function FavCmds.apply(btn)
	local title = tostring(btn:GetAttribute("Title") or btn.Text)
	local fav = FavCmds.is(title)
	local label = btn:FindFirstChild("Label")
	if label then
		label.TextColor3 = fav and Color3.fromRGB(255, 214, 102) or Color3.fromRGB(244, 244, 248)
	end
end]]

local NEW_FAV = [[function FavCmds.apply(btn)
	local title = tostring(btn:GetAttribute("Title") or btn.Text)
	local fav = FavCmds.is(title)
	local label = btn:FindFirstChild("Label")
	if label then
		label.TextColor3 = fav and Color3.fromRGB(255, 214, 102) or Color3.fromRGB(244, 244, 248)
		if btn:GetAttribute("SuggestKind") ~= "player" then
			label.Text = formatCmdRich(title, { fav = fav })
		end
	end
end]]

if not raw:find(OLD_FAV, 1, true) then
	error("Infinity Yield Plus: core FavCmds.apply not found")
end
raw = raw:gsub(OLD_FAV:gsub("(%W)", "%%%1"), NEW_FAV:gsub("%%", "%%%%"), 1)

local fn, err = loadstring(raw)
if not fn then
	error("Infinity Yield Plus: compile failed: " .. tostring(err))
end
fn()
