function ESP(plr, logic)
    task.spawn(function()
        if not plr or plr == Players.LocalPlayer then return end
        for _, v in pairs(COREGUI:GetChildren()) do
            if v.Name == plr.Name .. '_ESP' then
                v:Destroy()
            end
        end
        if not ESPenabled then return end

        local waited = 0
        repeat
            task.wait(0.1)
            waited += 0.1
            if not ESPenabled or not plr.Parent then return end
        until (plr.Character and (plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("UpperTorso")) and plr.Character:FindFirstChildOfClass("Humanoid")) or waited > 8

        local char = plr.Character
        if not char or not char.Parent then return end
        if not ESPenabled then return end

        local ESPholder = Instance.new("Folder")
        ESPholder.Name = plr.Name .. '_ESP'
        ESPholder.Parent = COREGUI

        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local box = Instance.new("BoxHandleAdornment")
                box.Name = plr.Name
                box.Parent = ESPholder
                box.Adornee = part
                box.AlwaysOnTop = true
                box.ZIndex = 10
                box.Size = part.Size
                box.Transparency = espTransparency or 0.3
                box.Color = BrickColor.new(
                    logic and (plr.TeamColor == Players.LocalPlayer.TeamColor and "Bright green" or "Bright red") or plr.TeamColor
                )
            end
        end

        local head = char:FindFirstChild("Head")
        local TextLabel
        if head then
            local BillboardGui = Instance.new("BillboardGui")
            BillboardGui.Name = plr.Name
            BillboardGui.Parent = ESPholder
            BillboardGui.Adornee = head
            BillboardGui.Size = UDim2.new(0, 100, 0, 150)
            BillboardGui.StudsOffset = Vector3.new(0, 1, 0)
            BillboardGui.AlwaysOnTop = true

            TextLabel = Instance.new("TextLabel")
            TextLabel.Parent = BillboardGui
            TextLabel.BackgroundTransparency = 1
            TextLabel.Size = UDim2.new(0, 100, 0, 100)
            TextLabel.Position = UDim2.new(0, 0, 0, -50)
            TextLabel.Font = Enum.Font.SourceSansSemibold
            TextLabel.TextSize = 20
            TextLabel.TextColor3 = Color3.new(1, 1, 1)
            TextLabel.TextStrokeTransparency = 0
            TextLabel.TextYAlignment = Enum.TextYAlignment.Bottom
            TextLabel.ZIndex = 10
            TextLabel.Text = plr.Name
        end

        local conns = {}
        local function killESP()
            for i = #conns, 1, -1 do
                pcall(function() conns[i]:Disconnect() end)
                conns[i] = nil
            end
            if ESPholder and ESPholder.Parent then
                ESPholder:Destroy()
                end
            end

        conns[#conns + 1] = plr.CharacterAdded:Connect(function()
            killESP()
            if ESPenabled then
                ESP(plr, logic)
            end
        end)
        conns[#conns + 1] = plr:GetPropertyChangedSignal("TeamColor"):Connect(function()
            killESP()
            if ESPenabled then
                ESP(plr, logic)
                end
            end)
        conns[#conns + 1] = Players.PlayerRemoving:Connect(function(leaving)
            if leaving == plr then
                killESP()
            end
        end)
        conns[#conns + 1] = RunService.Heartbeat:Connect(function()
            if not ESPenabled or not ESPholder.Parent then
                killESP()
                return
            end
            if not TextLabel then return end
            local c = plr.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            local root = c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso"))
            local lp = Players.LocalPlayer.Character
            local lroot = lp and (lp:FindFirstChild("HumanoidRootPart") or lp:FindFirstChild("Torso") or lp:FindFirstChild("UpperTorso"))
            if hum and root and lroot then
                local distance = math.floor((lroot.Position - root.Position).Magnitude)
                TextLabel.Text = string.format("Name: %s | Health: %.1f | Studs: %d", plr.Name, hum.Health, distance)
            end
        end)
    end)
end

