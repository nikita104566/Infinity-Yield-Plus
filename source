-- Infinity Yield Plus 7.63
-- One loadstring. Applies panel-row readability on the 7.50 core blob.
currentVersion = "7.63"

local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"

local ok, raw = pcall(function()
	return game:HttpGet(CORE)
end)
if not ok or type(raw) ~= "string" or raw == "" then
	error("[IYP] 7.63 could not download core source")
end

raw = raw:gsub("currentVersion = '7%.50'", "currentVersion = '7.63'", 1)
raw = raw:gsub("cmdListLayout%.Padding = UDim%.new%(0, 3%)", "cmdListLayout.Padding = UDim.new(0, 2)", 1)
raw = raw:gsub(
	"Example%.Size = UDim2%.new%(1, %-%(SCROLL_GUTTER %+ 2%), 0, 28%)",
	"Example.Size = UDim2.new(1, -(SCROLL_GUTTER + 2), 0, 22)",
	1
)

local needle = [[	local html = "<font color=\"#B8B4CC\">·</font> <font color=\"#F4F4F8\">" .. primary .. "</font>"
	if aliases ~= "" then
		html = html .. "<font color=\"#7A778C\"> " .. aliases .. "</font>"
	end]]

local insert = [[	local function glen(str)
		local n = utf8.len(str)
		return n or #str
	end
	local budget = 34
	local showAliases = aliases
	if glen(primary) + glen(aliases) + glen(args) + 3 > budget then
		local first = aliases:match("^%s*/%s*[^/%s]+") or ""
		if first ~= "" and glen(primary) + glen(first) + glen(args) + 3 <= budget then
			showAliases = first
		else
			showAliases = ""
		end
	end
	local html = "<font color=\"#B8B4CC\">·</font> <font color=\"#F4F4F8\">" .. primary .. "</font>"
	if showAliases ~= "" then
		html = html .. "<font color=\"#7A778C\"> " .. showAliases .. "</font>"
	end]]

local at = raw:find(needle, 1, true)
if at then
	raw = raw:sub(1, at - 1) .. insert .. raw:sub(at + #needle)
end

local fn, err = loadstring(raw)
if not fn then
	error("[IYP] 7.63 compile failed: " .. tostring(err))
end
return fn()
