function looksRussian(s)
	s = tostring(s or "")
	-- UTF-8 Cyrillic bytes (А-я and ё/Ё roughly)
	return s:find("\208[\144-\191]") ~= nil or s:find("\209[\128-\191]") ~= nil or s:find("\208\129") ~= nil or s:find("\209\145") ~= nil
end

function getLocalizedDesc(title, desc)
	desc = tostring(desc or "")
	if uiLang == "ru" then
		local key = cmdPrimaryKey(title)
		local ru = CMD_DESC_RU[key]
		if ru and ru ~= "" and looksRussian(ru) then
			return ru
		end
		if desc ~= "" then
			local translated = autoRuDesc(desc)
			if translated ~= "" and looksRussian(translated) then
				return translated
			end
		end
		if ru and ru ~= "" then
			return ru
		end
		return T("noDesc")
	end
	if desc == "" then
		return T("noDesc")
	end
	return desc
end

