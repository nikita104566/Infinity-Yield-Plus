-- Infinity Yield Plus 7.63
-- One loadstring. Pins the last full core and applies the command-row readability pass.
local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"
local raw = game:HttpGet(CORE)
if type(raw) ~= "string" or #raw < 1000 then
	error("Infinity Yield Plus: failed to fetch core source")
end
raw = raw:gsub("currentVersion = '7%.50'", "currentVersion = '7.63'", 1)
raw = raw:gsub(
	"Example%.Size = UDim2%.new%(1, %-%(SCROLL_GUTTER %+ 2%), 0, 28%)",
	"Example.Size = UDim2.new(1, -(SCROLL_GUTTER + 2), 0, 40)",
	1
)
raw = raw:gsub(
	'html = html %.%. " <font color=\\"#C4B5FD\\">" %.%. args %.%. "</font>"',
	'html = html .. "<br/><font color=\\"#A89BDB\\" size=\\"12\\">" .. args .. "</font>"',
	1
)
raw = raw:gsub(
	"label%.TextXAlignment = Enum%.TextXAlignment%.Left\n\tlabel%.TextColor3 = Color3%.fromRGB%(244, 244, 248%)\n\tlabel%.RichText = true\n\tlabel%.TextTruncate = Enum%.TextTruncate%.AtEnd",
	"label.TextXAlignment = Enum.TextXAlignment.Left\n\tlabel.TextYAlignment = Enum.TextYAlignment.Top\n\tlabel.TextColor3 = Color3.fromRGB(244, 244, 248)\n\tlabel.RichText = true\n\tlabel.TextWrapped = true\n\tlabel.TextTruncate = Enum.TextTruncate.AtEnd",
	1
)
raw = raw:gsub(
	"marker%.Position = UDim2%.new%(0, %-8, 0, 6%)\n\tmarker%.Size = UDim2%.new%(0, 2, 1, %-12%)",
	"marker.Position = UDim2.new(0, -8, 0, 8)\n\tmarker.Size = UDim2.new(0, 2, 1, -16)",
	1
)
assert(loadstring(raw))()
