	local function saveData()
		local result = {}
		for name, ev in pairs(events) do
			local list = {}
			for _, cmd in ipairs(ev.commands) do
				local meta = getMeta(cmd)
				local filters = {}
				for i, set in ipairs(ev.sets or {}) do
					filters[i] = normalizeFilter(cmd[2] and cmd[2][i], set.Type)
				end
				list[#list + 1] = {
					cmd[1],
					filters,
					boundedNumber(cmd[3], 0, 0),
					{
						enabled = meta.enabled ~= false,
						cooldown = tonumber(meta.cooldown) or 0,
						chance = tonumber(meta.chance) or 100,
						once = meta.once == true,
						maxRuns = tonumber(meta.maxRuns) or 0,
						delayMax = tonumber(meta.delayMax) or 0,
						v = 1,
					},
				}
			end
			result[name] = list
		end
		return HttpService:JSONEncode(result)
	end

	loadData = function(input)
		local data = input
		if type(input) ~= "table" then
			local ok
			ok, data = pcall(function() return HttpService:JSONDecode(input) end)
			if not ok then return end
		end
		if type(data) ~= "table" then return end
		cancelPendingFor(nil)
		runtime = setmetatable({}, { __mode = "k" })
		selectedCmd = nil
		for name, list in pairs(data) do
			if events[name] and type(list) == "table" then
				local cmds = {}
				for _, raw in ipairs(list) do
					if type(raw) == "table" then
						local cmd = { tostring(raw[1] or ""), {}, boundedNumber(raw[3], 0, 0) }
						local filters = {}
						local ev = events[name]
						for i, set in ipairs(ev.sets or {}) do
							filters[i] = normalizeFilter(raw[2] and raw[2][i], set.Type)
						end
						cmd[2] = filters
						if type(raw[4]) == "table" then
							cmd[4] = deepCopy(raw[4])
						elseif raw[4] == false then
							cmd[4] = { enabled = false, v = 1 }
						end
						getMeta(cmd)
						cmds[#cmds + 1] = cmd
					end
				end
				events[name].commands = cmds
			end
		end
	end

	local function addCmd(eventName, data)
		if not events[eventName] then return end
		local cmd
		if type(data) == "table" then
			cmd = { tostring(data[1] or ""), data[2] or defaultFilters(events[eventName]), boundedNumber(data[3], 0, 0), data[4] }
			if type(cmd[2]) == "table" then
				for i, set in ipairs(events[eventName].sets or {}) do
					cmd[2][i] = normalizeFilter(cmd[2][i], set.Type)
				end
			else
				cmd[2] = defaultFilters(events[eventName])
			end
		else
			cmd = { tostring(data or ""), defaultFilters(events[eventName]), 0 }
		end
		getMeta(cmd)
		table.insert(events[eventName].commands, cmd)
	end

	local function refreshList()
		refreshEventList()
		if selectedEventName and events[selectedEventName] then
			selectEvent(selectedEventName)
		elseif next(events) then
			local names = {}
			for n in pairs(events) do names[#names + 1] = n end
			table.sort(names)
			if names[1] then selectEvent(names[1]) end
		end
		updateCountLabel()
	end

	-- single interval scheduler
	task.spawn(function()
		local gen = IYR_GEN
		local elapsed = 0
		while IYR_GEN == gen do
			task.wait(1)
			if IYR_GEN ~= gen then return end
			elapsed += 1
			if events.OnInterval then
				fireEvent("OnInterval", elapsed)
			end
		end
	end)

