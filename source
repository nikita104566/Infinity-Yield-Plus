	local function revealSuggestion()
		local row = suggestionRows[suggestionIndex]
		if not row then return end
		local top = (suggestionIndex - 1) * 26
		local bottom = top + 24
		local viewTop = picker.CanvasPosition.Y
		local viewHeight = picker.AbsoluteWindowSize.Y
		if top < viewTop then
			picker.CanvasPosition = Vector2.new(0, top)
		elseif bottom > viewTop + viewHeight then
			picker.CanvasPosition = Vector2.new(0, math.max(0, bottom - viewHeight))
		end
	end
	local function applySuggestion(primary)
		if not primary or primary == "" then return end
		local cur = addBox.Text or ""
		local _, tokenStart, tokenEnd = activeCommandToken(cur)
		local before = cur:sub(1, tokenStart - 1)
		local after = cur:sub(tokenEnd + 1)
		if after == "" then
			addBox.Text = before .. primary .. " "
			local cursor = #before + #primary + 2
			setPickerVisible(false)
			task.defer(function()
				if addBox.Parent then
					addBox:CaptureFocus()
					addBox.CursorPosition = math.min(cursor, #addBox.Text + 1)
				end
			end)
			return
		end
		addBox.Text = before .. primary .. after
		local cursor = #before + #primary + 1
		setPickerVisible(false)
		task.defer(function()
			if addBox.Parent then
				addBox:CaptureFocus()
				addBox.CursorPosition = math.min(cursor, #addBox.Text + 1)
			end
		end)
	end
	local function refreshSuggestions()
		for _, c in ipairs(pickerHolder:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		suggestionRows = {}
		suggestionIndex = 0
		local raw = addBox.Text or ""
		local normalized = raw:gsub("://", "\1"):gsub("/", "\\"):gsub("\1", "://")
		if normalized ~= raw then
			local cursor = addBox.CursorPosition
			addBox.Text = normalized
			addBox.CursorPosition = cursor
			return
		end
		local q, _, _, chained = activeCommandToken(normalized)
		q = q:lower()
		if not CMDs or (q == "" and not chained) then
			setPickerVisible(false)
			return
		end
		local matches = {}
		for _, cmdDef in ipairs(CMDs) do
			local name = tostring(cmdDef.NAME or "")
			local primary = name:match("^%S+") or name
			local lowerName = name:lower()
			local lowerPrimary = primary:lower()
			local score = nil
			if q == "" then
				score = 4
			elseif lowerPrimary:sub(1, #q) == q then
				score = 0
			elseif lowerName:find(q, 1, true) then
				score = 2
			end
			if q ~= "" and type(cmdDef.ALIAS) == "table" then
				for _, alias in ipairs(cmdDef.ALIAS) do
					local lowerAlias = tostring(alias):lower()
					if lowerAlias:sub(1, #q) == q then
						score = math.min(score or 9, 1)
					elseif lowerAlias:find(q, 1, true) then
						score = math.min(score or 9, 3)
					end
				end
			end
			if score then
				matches[#matches + 1] = { name = name, primary = primary, score = score }
			end
		end
		table.sort(matches, function(a, b)
			if a.score == b.score then return a.primary:lower() < b.primary:lower() end
			return a.score < b.score
		end)
		local y = 0
		for index = 1, math.min(12, #matches) do
			local match = matches[index]
			local primary = match.primary
			local row = mk("TextButton", {
				BackgroundColor3 = Color3.fromRGB(36, 36, 46),
				BorderSizePixel = 0,
				Size = UDim2.new(1, -6, 0, 24),
				Text = "  " .. match.name,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = UI_FONT,
				TextSize = 11,
				TextColor3 = Color3.fromRGB(230, 230, 235),
				ZIndex = 51,
			}, pickerHolder)
			uiCorner(row, 4)
			row:SetAttribute("EEPrimary", primary)
			suggestionRows[#suggestionRows + 1] = row
			local rowIndex = #suggestionRows
			row.MouseEnter:Connect(function()
				suggestionIndex = rowIndex
				styleSuggestions()
			end)
			row.MouseButton1Click:Connect(function()
				applySuggestion(primary)
			end)
			y += 26
		end
		suggestionIndex = #suggestionRows > 0 and 1 or 0
		styleSuggestions()
		picker.CanvasPosition = Vector2.new(0, 0)
		picker.CanvasSize = UDim2.new(0, 0, 0, y)
		setPickerVisible(#suggestionRows > 0, y)
	end
