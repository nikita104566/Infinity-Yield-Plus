	local function substitute(cmdStr, args, eventName)
		local lp = Players.LocalPlayer
		local globals = {
			me = lp and lp.Name or "",
			place = tostring(PlaceId or game.PlaceId or ""),
			job = tostring(JobId or game.JobId or ""),
			time = os.date("%H:%M:%S"),
			event = tostring(eventName or ""),
		}
		local rendered = tostring(cmdStr or ""):gsub("%$([%w_]+)", function(token)
			local numeric = tonumber(token)
			if numeric and args[numeric] ~= nil then return tostring(args[numeric]) end
			local argIndex = namedArgMap[token]
			if argIndex and args[argIndex] ~= nil then return tostring(args[argIndex]) end
			if globals[token] ~= nil then return tostring(globals[token]) end
			return "$" .. token
		end)
		return rendered
	end

