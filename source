local function lastBackslashPos(text)
	local subPos = 0
	local pos = 1
	local findRes = string.find(text, "\\", pos, true)
	while findRes do
		subPos = findRes
		pos = findRes + 1
		findRes = string.find(text, "\\", pos, true)
	end
	return subPos
end

local function kbActiveSegment(text)
	text = text or ""
	if text:sub(-1) == "\\" then return "" end
	return text:sub(lastBackslashPos(text) + 1)
end

local function kbFillSegment(box, primary)
	if not box or not primary or primary == "" then return end
	local cur = box.Text or ""
	local subPos = lastBackslashPos(cur)
	box.Text = cur:sub(1, subPos) .. primary .. " "
	box.CursorPosition = #box.Text + 1
end

local function shortKbDesc(title, desc)
	local d = getLocalizedDesc(title, desc)
	if not d or d == "" then d = T("noDesc") end
	if #d > 52 then
		d = d:sub(1, 50) .. "…"
	end
	return d
end

local function buildRanked(query)
	local ranked = {}
	local q = (query or ""):match("^(%S+)") or (query or "")
	for i = 1, #CMDs do
		local cmd = CMDs[i]
		local name = cmd and cmd.NAME
		if name and name ~= "" then
			local primary = cmdPrimaryKey(name)
			if primary ~= "" then
				local score = commandScore(name, q)
				if q == "" then
					if type(isFavoriteCmd) == "function" and isFavoriteCmd(primary) then
						score = score + 2000
					elseif KB_POPULAR[primary] then
						score = score + 1000 - KB_POPULAR[primary]
					end
				else
					local loc = getLocalizedDesc(name, cmd.DESC or "")
					if loc:lower():find(q:lower(), 1, true) then
						score = score + 50
					end
				end
				if score > 0 then
					ranked[#ranked + 1] = {
						primary = primary,
						name = name,
						desc = cmd.DESC or "",
						score = score,
					}
				end
			end
		end
	end
	table.sort(ranked, function(a, b)
		if a.score == b.score then
			return a.primary < b.primary
		end
		return a.score > b.score
	end)
	return ranked
end

