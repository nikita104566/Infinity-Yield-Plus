function formatCmdRich(text)
	if not text or text == "" then
		return ""
	end
	local escaped = tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	local argAt = escaped:find("%[")
	local names = escaped
	local args = ""
	if argAt then
		names = escaped:sub(1, argAt - 1):gsub("%s+$", "")
		args = escaped:sub(argAt)
	end
	local primary, aliases = names:match("^([^/]+)%s*(.*)$")
	primary = (primary or names):gsub("%s+$", "")
	aliases = aliases or ""
	local html = "<font color=\"#B8B4CC\">·</font> <font color=\"#F4F4F8\">" .. primary .. "</font>"
	if aliases ~= "" then
		html = html .. "<font color=\"#7A778C\"> " .. aliases .. "</font>"
	end
	if args ~= "" then
		html = html .. " <font color=\"#C4B5FD\">" .. args .. "</font>"
	end
	return html
end

function applyCmdRowText(btn, text)
	if not btn then return end
	btn.Text = text
	local label = btn:FindFirstChild("Label")
	if label then
		if btn:GetAttribute("SuggestKind") == "player" then
			label.Text = "<font color=\"#EDE9FE\">" .. tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;") .. "</font>"
		else
			label.Text = formatCmdRich(text)
		end
	end
end

function setCmdRowSelected(btn, isSelected)
	if not btn then return end
	local marker = btn:FindFirstChild("Sel")
	if isSelected then
		btn.BackgroundTransparency = 0.92
		btn.BackgroundColor3 = ROW_PURPLE
		if marker then marker.Visible = true end
	else
		btn.BackgroundTransparency = 1
		btn.BackgroundColor3 = ROW_PURPLE
		if marker then marker.Visible = false end
	end
end

function styleCmdRow(btn)
	if btn:FindFirstChild("Sel") then
		applyCmdRowText(btn, btn.Text)
		return btn
	end
	btn.AutoButtonColor = false
	btn.Font = UI_FONT
	btn.TextSize = 13
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.TextTransparency = 1
	btn.BackgroundColor3 = ROW_PURPLE
	if not btn:FindFirstChildOfClass("UIPadding") then
		uiPad(btn, 4, 0, 10, 0)
	end
	if not btn:FindFirstChildOfClass("UICorner") then
		uiCorner(btn, 6)
	end
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.Font = UI_FONT
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = Color3.fromRGB(244, 244, 248)
	label.RichText = true
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 11
	label.Parent = btn
	applyCmdRowText(btn, btn.Text)
	local marker = Instance.new("Frame")
	marker.Name = "Sel"
	marker.BackgroundColor3 = ACCENT
	marker.BorderSizePixel = 0
	marker.Position = UDim2.new(0, -8, 0, 6)
	marker.Size = UDim2.new(0, 2, 1, -12)
	marker.Visible = false
	marker.ZIndex = 12
	marker.Parent = btn
	uiCorner(marker, 2)
	btn.MouseEnter:Connect(function()
		if cmdSelectionPainted and selectedCmdButton == btn then
			setCmdRowSelected(btn, true)
		else
			btn.BackgroundTransparency = 0.88
			btn.BackgroundColor3 = ROW_PURPLE_SOFT
			local m = btn:FindFirstChild("Sel")
			if m then m.Visible = false end
		end
		if not introPlaying and btn.Visible and btn:GetAttribute("Title") and type(showHelper) == "function" then
			showHelper(btn:GetAttribute("Title") or btn.Text, btn:GetAttribute("Desc"))
		end
	end)
	btn.MouseLeave:Connect(function()
		setCmdRowSelected(btn, cmdSelectionPainted and selectedCmdButton == btn)
		if type(checkTT) == "function" then
			task.defer(checkTT)
		end
	end)
	return btn
end

