--[[
	Infinity Yield Plus
	https://github.com/nikita104566/Infinity-Yield-Plus

	Load:
	loadstring(game:HttpGet('https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/main/source'))()
]]--

local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"
local ok, blob = pcall(function()
	return game:HttpGet(CORE)
end)
assert(ok and type(blob) == "string" and #blob > 1000, "IYP: failed to fetch core source")

local function once(hay, needle, repl)
	local i, j = string.find(hay, needle, 1, true)
	assert(i, "IYP patch miss: " .. string.sub(needle, 1, 60))
	return string.sub(hay, 1, i - 1) .. repl .. string.sub(hay, j + 1)
end

blob = once(blob, "currentVersion = '7.50'", "currentVersion = '7.63'")

blob = once(blob,
	'\t\tfavorites = "Favorites",\n\t\tallCommands = "Commands",\n',
	'\t\tfavorites = "Favorites",\n\t\tfavEmpty = "Right-click a command to pin it here",\n\t\tallCommands = "Commands",\n')

blob = once(blob,
	'\t\tfavorites = "Избранное",\n\t\tallCommands = "Команды",\n',
	'\t\tfavorites = "Избранное",\n\t\tfavEmpty = "ПКМ по команде — закрепить здесь",\n\t\tallCommands = "Команды",\n')

blob = once(blob,
	'\tif cmdFavHeader then cmdFavHeader.Text = T("favorites") end\n',
	'\tif cmdFavHeader then cmdFavHeader.Text = T("favorites") end\n\tif cmdFavEmpty then cmdFavEmpty.Text = T("favEmpty") end\n')

blob = once(blob,
	[[cmdFavHeader.Visible = false
cmdFavHeader.LayoutOrder = 1

cmdAllHeader = Instance.new("TextLabel")]],
	[[cmdFavHeader.Visible = false
cmdFavHeader.LayoutOrder = 1

cmdFavEmpty = Instance.new("TextLabel")
cmdFavEmpty.Name = "IYR_FAV_EMPTY"
cmdFavEmpty.Parent = CMDsF
cmdFavEmpty.BackgroundTransparency = 1
cmdFavEmpty.BorderSizePixel = 0
cmdFavEmpty.Size = UDim2.new(1, -(SCROLL_GUTTER + 2), 0, 18)
cmdFavEmpty.Font = UI_FONT
cmdFavEmpty.TextSize = 11
cmdFavEmpty.TextXAlignment = Enum.TextXAlignment.Left
cmdFavEmpty.TextYAlignment = Enum.TextYAlignment.Top
cmdFavEmpty.TextColor3 = Color3.fromRGB(140, 138, 152)
cmdFavEmpty.Text = T("favEmpty")
cmdFavEmpty.TextWrapped = true
cmdFavEmpty.TextTruncate = Enum.TextTruncate.AtEnd
cmdFavEmpty.ZIndex = 11
cmdFavEmpty.Visible = false
cmdFavEmpty.LayoutOrder = 2

cmdAllHeader = Instance.new("TextLabel")]])

blob = once(blob,
	[[    if cmdFavHeader then
        cmdFavHeader.Visible = not takesPlayer and #favRanked > 0
        cmdFavHeader.LayoutOrder = 1
    end]],
	[[    if cmdFavHeader then
        local showFavHead = not takesPlayer and (#favRanked > 0 or #(favCmds or {}) == 0)
        cmdFavHeader.Visible = showFavHead
        cmdFavHeader.LayoutOrder = 1
    end
    if cmdFavEmpty then
        cmdFavEmpty.Visible = not takesPlayer and #(favCmds or {}) == 0
        cmdFavEmpty.LayoutOrder = 2
        cmdFavEmpty.Text = T("favEmpty")
    end]])

local fn, err = loadstring(blob)
assert(fn, err or "IYP: bad patched core")
fn()
