--[[
	Infinity Yield Plus
	https://github.com/nikita104566/Infinity-Yield-Plus

	Load:
	loadstring(game:HttpGet('https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/main/source'))()
]]--

local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"
local ok, blob = pcall(function()
	return game:HttpGet(CORE)
end)
assert(ok and type(blob) == "string" and #blob > 1000, "IYP: failed to fetch core source")

local function once(hay, needle, repl)
	local i, j = string.find(hay, needle, 1, true)
	assert(i, "IYP patch miss: " .. string.sub(needle, 1, 60))
	return string.sub(hay, 1, i - 1) .. repl .. string.sub(hay, j + 1)
end

blob = once(blob, "currentVersion = '7.50'", "currentVersion = '7.63'")

blob = once(blob,
	'\t\trefOpsExcludeEx = ";locate %blue-friends (gets players in blue team who aren\'t your friends)",\n\t},',
	'\t\trefOpsExcludeEx = ";locate %blue-friends (gets players in blue team who aren\'t your friends)",\n\t\tsfriendsTitle = "Friends here",\n\t\tsfriendsNone = "No friends in this server",\n\t\tsfriendsSome = "Friends in this server",\n\t},')

blob = once(blob,
	'\t\trefOpsExcludeEx = ";locate %blue-friends (игроки синей команды, которые не друзья)",\n\t},',
	'\t\trefOpsExcludeEx = ";locate %blue-friends (игроки синей команды, которые не друзья)",\n\t\tsfriendsTitle = "Друзья здесь",\n\t\tsfriendsNone = "В этом сервере нет друзей",\n\t\tsfriendsSome = "Друзья на этом сервере",\n\t},')

blob = once(blob,
	"CMDs[#CMDs + 1] = {NAME = 'lastcommand / lastcmd', DESC = 'Executes the previous command used'}",
	"CMDs[#CMDs + 1] = {NAME = 'lastcommand / lastcmd', DESC = 'Executes the previous command used'}\nCMDs[#CMDs + 1] = {NAME = 'serverfriends / sfriends / friendson', DESC = 'Lists friends who are in this server'}")

blob = once(blob,
	[[addcmd('lastcommand',{'lastcmd'},function(args, speaker)
    if cmdHistory[1]:sub(1,11) ~= 'lastcommand' and cmdHistory[1]:sub(1,7) ~= 'lastcmd' then
        execCmd(cmdHistory[1])
    end
end)]],
	[[addcmd('lastcommand',{'lastcmd'},function(args, speaker)
    if cmdHistory[1]:sub(1,11) ~= 'lastcommand' and cmdHistory[1]:sub(1,7) ~= 'lastcmd' then
        execCmd(cmdHistory[1])
    end
end)

addcmd('serverfriends',{'sfriends','friendson'},function(args, speaker)
    local names = {}
    local me = speaker or (Players and Players.LocalPlayer)
    if not me then
        notify(T("sfriendsTitle"), T("sfriendsNone"))
        return
    end
    local list = Players:GetPlayers()
    for i = 1, #list do
        local p = list[i]
        if p ~= me then
            local okF, isF = pcall(function()
                return me:IsFriendsWith(p.UserId)
            end)
            if okF and isF then
                names[#names + 1] = p.Name
            end
        end
    end
    if #names == 0 then
        notify(T("sfriendsTitle"), T("sfriendsNone"))
    else
        notify(T("sfriendsSome"), table.concat(names, ", "))
    end
end)]])

local fn, err = loadstring(blob)
assert(fn, err or "IYP: bad patched core")
fn()
