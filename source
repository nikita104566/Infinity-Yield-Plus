AntiFlingEnabled = false
AntiFlingConn = nil

local function setCanCollideOfModelDescendants(model, bval)
    if not model then
        return
    end
    pcall(function()
        for _, v in pairs(model:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = bval
        end
    end
    end)
end

function applyAntiFling(state)
    AntiFlingEnabled = state and true or false
    if AntiFlingConn then
        pcall(function() AntiFlingConn:Disconnect() end)
        AntiFlingConn = nil
    end
    if AntiFlingEnabled then
        AntiFlingConn = IYR_TRACK(RunService.Stepped:Connect(function()
            if not AntiFlingEnabled then
                return
            end
            local lp = Players.LocalPlayer
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= lp then
                    local char = plr.Character
                    if char then
                        setCanCollideOfModelDescendants(char, false)
    end
end
            end
        end))
    else
        local lp = Players.LocalPlayer
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp and plr.Character then
                setCanCollideOfModelDescendants(plr.Character, true)
            end
        end
    end
end

local wtvp = function(...) 
    local cam = workspace.CurrentCamera
    if not cam then
        return Vector2.zero, false, 0
    end
    local ok, a, b = pcall(function(...)
        return cam:WorldToViewportPoint(...)
    end, ...)
    if not ok or typeof(a) ~= "Vector3" then
        return Vector2.zero, false, 0
    end
    return Vector2.new(a.X, a.Y), b, a.Z 
end

