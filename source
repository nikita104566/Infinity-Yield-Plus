	local function activeCommandToken(text)
		text = tostring(text or "")
		local segmentStart = 1
		local searchFrom = 1
		local chained = false
		while true do
			local slash = text:find("\\", searchFrom, true)
			if not slash then break end
			chained = true
			segmentStart = slash + 1
			searchFrom = slash + 1
		end
		local segment = text:sub(segmentStart)
		local leading, token = segment:match("^(%s*)(%S*)")
		leading = leading or ""
		token = token or ""
		local tokenStart = segmentStart + #leading
		return token, tokenStart, tokenStart + #token - 1, chained
	end

