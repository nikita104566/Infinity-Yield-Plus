-- Infinity Yield Plus 7.63
-- One loadstring. Fetches the pinned 7.50 core and applies the favorite-star list patch.
local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"

local raw
do
	local ok, res = pcall(function()
		return game:HttpGet(CORE)
	end)
	if not ok or type(res) ~= "string" or #res < 1000 then
		error("[IYP] failed to fetch core source")
	end
	raw = res
end

raw = string.gsub(raw, "currentVersion = '7.50'", "currentVersion = '7.63'", 1)

local OLD_APPLY = [[function applyCmdRowText(btn, text)
	if not btn then return end
	btn.Text = text
	local label = btn:FindFirstChild("Label")
	if label then
		if btn:GetAttribute("SuggestKind") == "player" then
			label.Text = "<font color=\"#EDE9FE\">" .. tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;") .. "</font>"
		else
			label.Text = formatCmdRich(text)
		end
	end
end]]

local NEW_APPLY = [[function applyCmdRowText(btn, text)
	if not btn then return end
	btn.Text = text
	local label = btn:FindFirstChild("Label")
	if label then
		if btn:GetAttribute("SuggestKind") == "player" then
			label.Text = "<font color=\"#EDE9FE\">" .. tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;") .. "</font>"
		else
			local html = formatCmdRich(text)
			local title = tostring(btn:GetAttribute("Title") or text)
			if type(isFavoriteCmd) == "function" then
				local ok, fav = pcall(isFavoriteCmd, title)
				if ok and fav then
					html = string.gsub(html, '<font color="#B8B4CC">·</font>', '<font color="#FFD666">★</font>', 1)
				end
			end
			label.Text = html
		end
	end
end]]

local n
raw, n = string.gsub(raw, OLD_APPLY, NEW_APPLY, 1)
if n ~= 1 then
	warn("[IYP] applyCmdRowText patch missed")
end

local OLD_FAV = [[function FavCmds.apply(btn)
	local title = tostring(btn:GetAttribute("Title") or btn.Text)
	local fav = FavCmds.is(title)
	local label = btn:FindFirstChild("Label")
	if label then
		label.TextColor3 = fav and Color3.fromRGB(255, 214, 102) or Color3.fromRGB(244, 244, 248)
	end
end]]

local NEW_FAV = [[function FavCmds.apply(btn)
	local title = tostring(btn:GetAttribute("Title") or btn.Text)
	local fav = FavCmds.is(title)
	local label = btn:FindFirstChild("Label")
	if label then
		label.TextColor3 = fav and Color3.fromRGB(255, 214, 102) or Color3.fromRGB(244, 244, 248)
		if btn:GetAttribute("SuggestKind") ~= "player" then
			local html = formatCmdRich(btn.Text)
			if fav then
				html = string.gsub(html, '<font color="#B8B4CC">·</font>', '<font color="#FFD666">★</font>', 1)
			end
			label.Text = html
		end
	end
end]]

raw, n = string.gsub(raw, OLD_FAV, NEW_FAV, 1)
if n ~= 1 then
	warn("[IYP] FavCmds.apply patch missed")
end

local fn, err = loadstring(raw)
if not fn then
	error("[IYP] loadstring failed: " .. tostring(err))
end
return fn()
