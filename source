	local function queueCommand(name, cmd, args, forceRun)
		local rawCommand = tostring(cmd[1] or "")
		if rawCommand:match("^%s*$") then return false end
		local meta = getMeta(cmd)
		local delayMin = boundedNumber(cmd[3], 0, 0)
		local delayMax = boundedNumber(meta.delayMax, 0, 0)
		local waitFor = delayMin
		if delayMax > delayMin then
			waitFor = delayMin + math.random() * (delayMax - delayMin)
		end
		local cmdCopy = cmd
		local eventName = name
		local argsCopy = table.clone and table.clone(args) or { table.unpack(args) }
		local rt = getRuntime(cmdCopy)
		rt.pending += 1
		rt.lastQueued = tick()
		local record = { cmd = cmdCopy, event = name, runtime = rt, queuedAt = rt.lastQueued }
		pendingTasks[#pendingTasks + 1] = record
		local thread
		thread = task.spawn(function()
			if waitFor > 0 then task.wait(waitFor) end
			local metaNow = getMeta(cmdCopy)
			local rtNow = getRuntime(cmdCopy)
			if not forceRun then
				if masterPaused or metaNow.enabled == false then
					removePending(record)
					return
				end
				if metaNow.once and rtNow.onceDone then
					removePending(record)
					return
				end
				if metaNow.maxRuns > 0 and rtNow.runs >= metaNow.maxRuns then
					removePending(record)
					return
				end
				if metaNow.cooldown > 0 and (tick() - (rtNow.lastRun or 0)) < metaNow.cooldown then
					removePending(record)
					return
				end
			end
			local finalCmd = rawCommand
			local previousQueueFlag = IYP_EE_FROM_QUEUE
			IYP_EE_FROM_QUEUE = true
			local ok, err = pcall(function()
				finalCmd = substitute(cmdCopy[1], argsCopy, eventName)
				execCmd(finalCmd)
			end)
			IYP_EE_FROM_QUEUE = previousQueueFlag
			local rt2 = getRuntime(cmdCopy)
			rt2.runs += 1
			rt2.lastRun = tick()
			rt2.lastCmd = finalCmd
			if getMeta(cmdCopy).once then rt2.onceDone = true end
			if not ok then
				rt2.lastError = tostring(err)
				pushHistory({ event = eventName, cmd = finalCmd, ok = false, err = tostring(err), t = os.time() })
			else
				rt2.lastError = ""
				pushHistory({ event = eventName, cmd = finalCmd, ok = true, err = "", t = os.time() })
			end
			removePending(record)
		end)
		record.thread = thread
		return true
	end

	local function fireEvent(name, ...)
		local args = { ... }
		local event = events[name]
		if not event then return 0 end
		local force = forceTest
		forceTest = false
		if masterPaused and not force then
			lastSkipReasons[#lastSkipReasons + 1] = T("eeSkipPaused")
			return 0
		end
		local now = tick()
		if now - lastFireTick < 0.01 and fireDepth > 8 then return 0 end
		lastFireTick = now
		fireDepth += 1
		if fireDepth > 12 then
			fireDepth -= 1
			lastSkipReasons[#lastSkipReasons + 1] = T("eeSkipNone")
			return 0
		end
		local queued = 0
		for _, cmd in ipairs(event.commands) do
			local meta = getMeta(cmd)
			local rt = getRuntime(cmd)
			if force then
				if queueCommand(name, cmd, args, true) then queued += 1 end
			else
				local skip = false
				local why = nil
				local healthKey = nil
				if meta.enabled == false then
					skip = true
					why = T("eeSkipOff")
				elseif meta.once and (rt.onceDone or rt.pending > 0) then
					skip = true
					why = T("eeSkipOnce")
				elseif meta.maxRuns > 0 and (rt.runs + rt.pending) >= meta.maxRuns then
					skip = true
					why = T("eeSkipMax")
				elseif meta.cooldown > 0 and (now - math.max(rt.lastRun or 0, rt.lastQueued or 0)) < meta.cooldown then
					skip = true
					why = T("eeSkipCooldown")
				elseif name == "OnHealthBelow" then
					healthKey = tostring(args[1] or "_")
					local numFilter = normalizeFilter(cmd[2] and cmd[2][2], "Number")
					if (numFilter.mode or "any") == "any" then
						numFilter = { v = 1, mode = "lte", value = tonumber(numFilter.value) or 25, invert = numFilter.invert }
					end
					local playerFilter = cmd[2] and cmd[2][1]
					local playerMatches = applyInvert(playerFilter, matchPlayerFilter(playerFilter, args[1]))
					local below = applyInvert(numFilter, matchNumberFilter(numFilter, args[2]))
					if not playerMatches then
						skip = true
						why = T("eeSkipFilters")
					elseif not below then
						rt.belowArmedBy[healthKey] = nil
						skip = true
					elseif rt.belowArmedBy[healthKey] == false then
						skip = true
					end
				elseif not evalConditions(event, cmd, args) then
					skip = true
					why = T("eeSkipFilters")
				end
				if skip then
					rt.skipped += 1
					if why then lastSkipReasons[#lastSkipReasons + 1] = why end
				else
					if meta.chance < 100 and math.random(1, 100) > meta.chance then
						rt.skipped += 1
						lastSkipReasons[#lastSkipReasons + 1] = T("eeSkipChance")
					elseif queueCommand(name, cmd, args, false) then
						queued += 1
						if healthKey then rt.belowArmedBy[healthKey] = false end
					end
				end
			end
		end
		fireDepth -= 1
		return queued
	end

