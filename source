addcmd('stareat',{'stare'},function(args, speaker)
    local players = getPlayer(args[1], speaker)
    local prediction = args[2] and args[2]:lower() == "true" or false
    local smoothness = args[3] and tonumber(args[3]) or 0
    if smoothness < 0 then smoothness = 0 elseif smoothness > 1 then smoothness = 1 end
    
    for i,v in pairs(players) do
        if stareLoop then
            stareLoop:Disconnect()
        end
        if not Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or not Players[v].Character:FindFirstChild("HumanoidRootPart") then return end
        
        local function stareFunc(dt)
            if not Players.LocalPlayer.Character.PrimaryPart or not Players:FindFirstChild(v) or not Players[v].Character or not Players[v].Character:FindFirstChild("HumanoidRootPart") then
                if stareLoop then
                    stareLoop:Disconnect()
                end
                return
            end
            
            local chrPos = Players.LocalPlayer.Character.PrimaryPart.Position
            local targetRoot = Players[v].Character:FindFirstChild("HumanoidRootPart")
            local tPos = targetRoot.Position
            
            if prediction then
                tPos = tPos + targetRoot.Velocity * dt
            end
            
            local modTPos = Vector3.new(tPos.X, chrPos.Y, tPos.Z)
            local targetCF = CFrame.new(chrPos, modTPos)
            
            if smoothness == 0 then
                Players.LocalPlayer.Character:SetPrimaryPartCFrame(targetCF)
            else
                local alpha = math.max(0.05, 1 - smoothness * 0.95)  -- Higher smoothness = smaller alpha = smoother/slower
                local currentCF = Players.LocalPlayer.Character.PrimaryPart.CFrame
                local lerpedCF = currentCF:Lerp(targetCF, alpha)
                Players.LocalPlayer.Character:SetPrimaryPartCFrame(lerpedCF)
            end
        end

        stareLoop = RunService.RenderStepped:Connect(stareFunc)
    end
end)

