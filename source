function commandScore(displayName, query)
    if not displayName or displayName == "" then
        return (not query or query == "") and 1 or 0
    end
    if not query or query == "" then
        return 1
    end
    local lower = displayName:lower()
    local q = query:lower()
    local first = lower:match("^%S+") or lower
    if first == q then return 1000 end
    if #q > 0 and first:sub(1, #q) == q then return 900 - #first end
    local stripped = lower:gsub("%[.-%]", "")
    local foundAt = stripped:find(q, 1, true)
    if foundAt then return 500 - foundAt end
    foundAt = lower:find(q, 1, true)
    if foundAt then return 300 - foundAt end
    local fi = 1
    for i = 1, #q do
        local at = lower:find(q:sub(i, i), fi, true)
        if not at then return 0 end
        fi = at + 1
    end
    return 40
end

