-- Infinity Yield Plus 7.63
-- Player loadstring stays one line on this file. Applies favorite-star patch to pinned core.
local CORE_URL = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"
local okGet, raw = pcall(function()
	return game:HttpGet(CORE_URL)
end)
if not okGet or type(raw) ~= "string" or #raw < 100000 then
	error("[IYP] failed to load core source")
end

raw = raw:gsub("currentVersion = '7%.50'", "currentVersion = '7.63'", 1)

local function applyOnce(src, needle, repl, tag)
	local i, j = string.find(src, needle, 1, true)
	if not i then
		error("[IYP] missing anchor: " .. tag)
	end
	return string.sub(src, 1, i - 1) .. repl .. string.sub(src, j + 1)
end

raw = applyOnce(raw,
	"\tlabel.TextTruncate = Enum.TextTruncate.AtEnd\n\tlabel.ZIndex = 11\n\tlabel.Parent = btn\n\tapplyCmdRowText(btn, btn.Text)",
	"\tlabel.TextTruncate = Enum.TextTruncate.AtEnd\n\tlabel.ZIndex = 11\n\tlabel.Size = UDim2.new(1, -18, 1, 0)\n\tlabel.Parent = btn\n\tlocal star = Instance.new(\"TextLabel\")\n\tstar.Name = \"FavStar\"\n\tstar.BackgroundTransparency = 1\n\tstar.Size = UDim2.new(0, 16, 1, 0)\n\tstar.Position = UDim2.new(1, -16, 0, 0)\n\tstar.Font = UI_FONT\n\tstar.TextSize = 13\n\tstar.Text = \"★\"\n\tstar.TextColor3 = Color3.fromRGB(255, 214, 102)\n\tstar.TextXAlignment = Enum.TextXAlignment.Right\n\tstar.Visible = false\n\tstar.ZIndex = 12\n\tstar.Parent = btn\n\tapplyCmdRowText(btn, btn.Text)",
	"styleCmdRow")

raw = applyOnce(raw,
	"function FavCmds.apply(btn)\n\tlocal title = tostring(btn:GetAttribute(\"Title\") or btn.Text)\n\tlocal fav = FavCmds.is(title)\n\tlocal label = btn:FindFirstChild(\"Label\")\n\tif label then\n\t\tlabel.TextColor3 = fav and Color3.fromRGB(255, 214, 102) or Color3.fromRGB(244, 244, 248)\n\tend\nend",
	"function FavCmds.apply(btn)\n\tlocal title = tostring(btn:GetAttribute(\"Title\") or btn.Text)\n\tlocal fav = FavCmds.is(title)\n\tlocal label = btn:FindFirstChild(\"Label\")\n\tif label then\n\t\tlabel.TextColor3 = fav and Color3.fromRGB(255, 214, 102) or Color3.fromRGB(244, 244, 248)\n\t\tlabel.Size = fav and UDim2.new(1, -18, 1, 0) or UDim2.new(1, 0, 1, 0)\n\tend\n\tlocal star = btn:FindFirstChild(\"FavStar\")\n\tif not star then\n\t\tstar = Instance.new(\"TextLabel\")\n\t\tstar.Name = \"FavStar\"\n\t\tstar.BackgroundTransparency = 1\n\t\tstar.Size = UDim2.new(0, 16, 1, 0)\n\t\tstar.Position = UDim2.new(1, -16, 0, 0)\n\t\tstar.Font = UI_FONT\n\t\tstar.TextSize = 13\n\t\tstar.Text = \"★\"\n\t\tstar.TextColor3 = Color3.fromRGB(255, 214, 102)\n\t\tstar.TextXAlignment = Enum.TextXAlignment.Right\n\t\tstar.ZIndex = 12\n\t\tstar.Parent = btn\n\tend\n\tstar.Visible = fav and true or false\nend",
	"FavCmds.apply")

local fn, err = loadstring(raw)
if not fn then
	error("[IYP] compile failed: " .. tostring(err))
end
return fn()
