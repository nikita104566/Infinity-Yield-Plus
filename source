	end

	local function matchPlayerFilter(filter, argVal)
		local f = normalizeFilter(filter, "Player")
		local mode = f.mode or "any"
		local lp = Players.LocalPlayer
		local name = tostring(argVal or "")
		if mode == "any" then return true end
		if not lp then return false end
		if mode == "me" then return name == lp.Name or name == tostring(lp) end
		if mode == "others" then return name ~= lp.Name and name ~= tostring(lp) end
		if mode == "friend" or mode == "nonfriend" then
			local plr = findPlayerByArg(argVal)
			if not plr then return false end
			local ok, isFriend = pcall(function() return lp:IsFriendsWith(plr.UserId) end)
			if not ok then return false end
			return mode == "friend" and isFriend or mode == "nonfriend" and not isFriend
		end
		if mode == "team" then
			local plr = findPlayerByArg(argVal)
			if not plr or not lp.Team then return false end
			return plr.Team == lp.Team
		end
		if mode == "alive" or mode == "dead" or mode == "allies" or mode == "enemies" or mode == "nonteam" then
			return playerInCase(mode, name, lp)
		end
		if mode == "named" then
			local want = tostring(f.value or "")
			if want == "" then return true end
			return name:lower() == want:lower()
		end
		if mode == "display" then
			local plr = findPlayerByArg(argVal)
			local dn = plr and tostring(plr.DisplayName or "") or name
			local want = tostring(f.value or "")
			if want == "" then return true end
			return string.find(dn:lower(), want:lower(), 1, true) ~= nil
		end
		if mode == "inradius" then
			local studs = tonumber(f.value) or 0
			return playerInCase("rad" .. tostring(math.floor(studs)), name, lp)
		end
		if mode == "group" then
			local gid = tonumber(f.value)
			if not gid then return false end
			return playerInCase("group" .. tostring(math.floor(gid)), name, lp)
		end
		if mode == "whitelist" or mode == "blacklist" then
			local val = tostring(f.value or "")
			local hit = false
			for part in string.gmatch(val, "[^|]+") do
				part = (part:match("^%s*(.-)%s*$") or part):lower()
				if part ~= "" and name:lower() == part then
					hit = true
					break
				end
			end
			if mode == "whitelist" then return hit or val == "" end
			return not hit
		end
		if mode == "age" then
			local maxAge = tonumber(f.value) or 0
			return playerInCase("age" .. tostring(math.floor(maxAge)), name, lp)
		end
		local custom = tostring(f.value or "")
		if custom == "" then return true end
		local ok, list = pcall(function() return getPlayer(custom, lp) end)
		if ok and type(list) == "table" then
			return table.find(list, name) ~= nil or table.find(list, argVal) ~= nil
		end
		return string.find(name:lower(), custom:lower(), 1, true) ~= nil
	end

	local function matchStringFilter(filter, argVal)
		local f = normalizeFilter(filter, "String")
		if (f.mode or "any") == "any" then return true end
		local s = tostring(argVal or "")
		local val = tostring(f.value or "")
		local a, b = s, val
		if not f.case then
			a, b = s:lower(), val:lower()
		end
		local mode = f.mode
		local function one(mode2, aa, bb, rawS, rawV)
			if mode2 == "contains" then return string.find(aa, bb, 1, true) ~= nil end
			if mode2 == "notcontains" then return string.find(aa, bb, 1, true) == nil end
			if mode2 == "exact" then return aa == bb end
			if mode2 == "startswith" then return string.sub(aa, 1, #bb) == bb end
			if mode2 == "endswith" then return string.sub(aa, -#bb) == bb end
			if mode2 == "pattern" then
				local ok, found = pcall(string.find, rawS, rawV)
				return ok and found ~= nil
			end
			if mode2 == "empty" then return rawS == "" end
			if mode2 == "notempty" then return rawS ~= "" end
			if mode2 == "length_gt" then return #rawS > (tonumber(rawV) or 0) end
			if mode2 == "length_lt" then return #rawS < (tonumber(rawV) or 0) end
			return true
		end
		if string.find(val, "|", 1, true) then
			for part in string.gmatch(val, "[^|]+") do
				part = (part:match("^%s*(.-)%s*$") or part)
				local bb = f.case and part or part:lower()
				if one(mode, a, bb, s, part) then return true end
			end
			return false
		end
		return one(mode, a, b, s, val)
	end

	local function matchNumberFilter(filter, argVal)
		local f = normalizeFilter(filter, "Number")
		if (f.mode or "any") == "any" then return true end
		local n = tonumber(argVal)
		if not n then return false end
		local v = tonumber(f.value) or 0
		local mode = f.mode
		if mode == "lt" then return n < v end
		if mode == "lte" then return n <= v end
		if mode == "eq" then return n == v end
		if mode == "gte" then return n >= v end
		if mode == "gt" then return n > v end
		if mode == "range" then
			local vmax = tonumber(f.valueMax) or v
			return n >= math.min(v, vmax) and n <= math.max(v, vmax)
		end
		if mode == "neq" then return n ~= v end
		if mode == "outside" then
			local vmax = tonumber(f.valueMax) or v
			local lo, hi = math.min(v, vmax), math.max(v, vmax)
			return n < lo or n > hi
		end
		return n <= v
	end

	local function evalConditions(event, cmd, args)
		for idx, set in ipairs(event.sets or {}) do
			local filter = cmd[2] and cmd[2][idx]
			local argVal = args[idx]
			if set.Type == "Player" then
				if not applyInvert(filter, matchPlayerFilter(filter, argVal)) then return false end
			elseif set.Type == "String" then
				if not applyInvert(filter, matchStringFilter(filter, argVal)) then return false end
			elseif set.Type == "Number" then
				if not applyInvert(filter, matchNumberFilter(filter, argVal)) then return false end
			end
		end
		return true
	end

