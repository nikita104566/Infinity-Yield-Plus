		for i = 1, #godProtectConns do
			pcall(function() godProtectConns[i]:Disconnect() end)
		end
		godProtectConns = {}
		if godHeartbeat then
			pcall(function() godHeartbeat:Disconnect() end)
			godHeartbeat = nil
		end
	end

