	local function uiFit()
		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(EE_W + 24, EE_H + 24)
		return math.min(1, math.max(0.72, (viewport.X - 24) / EE_W), math.max(0.72, (viewport.Y - 24) / EE_H))
	end

	local function eeOpenPos()
		local fit = mainScale.Scale > 0 and mainScale.Scale or uiFit()
		return UDim2.new(0.5, -(EE_W * fit) / 2, 0.5, -(EE_H * fit) / 2)
	end

	local function eeHiddenPos()
		local fit = mainScale.Scale > 0 and mainScale.Scale or 1
		local g = 1
		pcall(function()
			if Scale then g = tonumber(Scale.Scale) or 1 end
		end)
		if g < 0.2 then g = 0.2 end
		return UDim2.new(0.5, -(EE_W * fit) / 2, 0, -(EE_H * fit) / g - 80)
	end

