--[[
	Infinity Yield Plus 7.63
	Loads the 7.50 core from a pinned commit, then applies the panel match-count
	line in the same player loadstring so Potassium keeps one environment.
]]

local CORE_URL = 'https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source'

local ok, raw = pcall(function()
	return game:HttpGet(CORE_URL)
end)
if not ok or type(raw) ~= 'string' or raw == '' then
	error('Infinity Yield Plus: failed to fetch core source')
end

raw = string.gsub(raw, "currentVersion = '7.50'", "currentVersion = '7.63'", 1)

raw = string.gsub(
	raw,
	'\tallCommands = "Commands",\n\t\taddFavorite = "Add to favorites",',
	'\tallCommands = "Commands",\n\t\tcmdMatchCount = "%d match",\n\t\tcmdMatchCountN = "%d matches",\n\t\taddFavorite = "Add to favorites",',
	1
)

raw = string.gsub(
	raw,
	'\tallCommands = "Команды",\n\t\taddFavorite = "В избранное",',
	'\tallCommands = "Команды",\n\t\tcmdMatchCount = "%d совпадение",\n\t\tcmdMatchCountN = "%d совпадений",\n\t\taddFavorite = "В избранное",',
	1
)

local OLD_HDR = [[    if cmdFavHeader then
        cmdFavHeader.Visible = not takesPlayer and #favRanked > 0
        cmdFavHeader.LayoutOrder = 1
    end
    if cmdAllHeader then
        cmdAllHeader.Visible = not takesPlayer and #favRanked > 0 and #otherRanked > 0
        cmdAllHeader.LayoutOrder = 500
    end]]

local NEW_HDR = [[    if cmdFavHeader then
        cmdFavHeader.Visible = not takesPlayer and #favRanked > 0
        cmdFavHeader.LayoutOrder = 1
    end
    if cmdAllHeader then
        local matchN = #favRanked + #otherRanked
        local filtering = type(str) == "string" and str ~= "" and not takesPlayer
        if filtering then
            local key = matchN == 1 and "cmdMatchCount" or "cmdMatchCountN"
            cmdAllHeader.Text = string.format(T(key), matchN)
            cmdAllHeader.Visible = true
        else
            cmdAllHeader.Text = T("allCommands")
            cmdAllHeader.Visible = not takesPlayer and #favRanked > 0 and #otherRanked > 0
        end
        cmdAllHeader.LayoutOrder = 500
    end]]

local patched, n = string.gsub(raw, OLD_HDR, NEW_HDR, 1)
if n ~= 1 then
	patched = raw
end

local fn, err = loadstring(patched)
if not fn then
	error('Infinity Yield Plus: core compile failed: ' .. tostring(err))
end
fn()
