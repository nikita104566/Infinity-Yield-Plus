local INTRO_HOLD = 1.0
local INTRO_FADE_OUT = 0.85
local INTRO_AUTOHIDE = 1.5

introPlaying = true
introDone = false
introConn = nil
introStartedAt = os.clock()
introCommandsReady = false
introFadeStart = nil
introMaximized = false
function holderHovered()
	if not (Holder and IYMouse) then return false end
	local p = Holder.AbsolutePosition
	local s = Holder.AbsoluteSize
	return IYMouse.X >= p.X and IYMouse.X <= p.X + s.X
		and IYMouse.Y >= p.Y and IYMouse.Y <= p.Y + s.Y
end
function scheduleIntroMinimize()
	task.delay(INTRO_AUTOHIDE, function()
		if StayOpen then return end
		if Cmdbar and Cmdbar:IsFocused() then return end
		if holderHovered() then return end
		if type(minimizeHolder) == "function" then
			pcall(minimizeHolder)
		end
	end)
end
function finishIntro()
	if introDone then return end
	introDone = true
	introPlaying = false
	if introConn then
		pcall(function() introConn:Disconnect() end)
		introConn = nil
	end
	pcall(function()
		if IntroBackground then
			IntroBackground.Visible = false
			IntroBackground.Active = false
		end
		if Logo then Logo:Destroy() end
		if IntroBackground then IntroBackground:Destroy() end
	end)
	Logo = nil
	IntroBackground = nil
	task.spawn(function()
		local t0 = os.clock()
		while not introCommandsReady and os.clock() - t0 < 6 do
			task.wait(0.05)
		end
		scheduleIntroMinimize()
	end)
end

function startIntroReveal()
	if type(maximizeHolder) == "function" then
		pcall(maximizeHolder)
	end
end

do
	local skipNow = false
	pcall(function()
		local genv = (getgenv and getgenv()) or _G
		skipNow = genv.IYR_SKIP_INTRO == true
		genv.IYR_SKIP_INTRO = nil
	end)
	if skipNow then
		finishIntro()
	else
		introConn = RunService.Heartbeat:Connect(function()
			if introDone then return end
			if not introMaximized and type(maximizeHolder) == "function" then
				introMaximized = true
				pcall(maximizeHolder)
			end
			if (os.clock() - introStartedAt) < INTRO_HOLD or not introCommandsReady then
				pcall(function()
					if Logo then Logo.ImageTransparency = 0 end
					if IntroBackground then IntroBackground.BackgroundTransparency = 0 end
				end)
				return
			end
			if introFadeStart == nil then
				introFadeStart = os.clock()
				pcall(function()
					if IntroBackground then IntroBackground.Active = false end
				end)
			end
			local e = 1 - math.cos(math.clamp((os.clock() - introFadeStart) / INTRO_FADE_OUT, 0, 1) * math.pi * 0.5)
			pcall(function()
				if Logo then Logo.ImageTransparency = e end
				if IntroBackground then IntroBackground.BackgroundTransparency = e end
			end)
			if e >= 1 then
				finishIntro()
			end
		end)
		pcall(function()
			task.delay(8, finishIntro)
		end)
	end
end

