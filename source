-- Infinity Yield Plus 7.63 — Studio command picker empty state
-- Single loadstring. Fetches core e30e0ec and applies picker + version replacements.
local coreUrl = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"
local ok, raw = pcall(function()
	return game:HttpGet(coreUrl)
end)
assert(ok and type(raw) == "string" and #raw > 1000, "IYP: failed to fetch core source")

raw = raw:gsub("currentVersion = '7.50'", "currentVersion = '7.63'", 1)

raw = raw:gsub(
	'\teeNoEventsMatch = "No events match this filter.",',
	'\teeNoEventsMatch = "No events match this filter.",\n\t\teeNoCmdMatch = "No matching commands",',
	1
)
raw = raw:gsub(
	'\teeNoEventsMatch = "Нет событий по этому фильтру.",',
	'\teeNoEventsMatch = "Нет событий по этому фильтру.",\n\t\teeNoCmdMatch = "Нет подходящих команд",',
	1
)

raw = raw:gsub(
	'if not CMDs or %(q == "" and not chained%) then',
	'if not CMDs or q == "" then',
	1
)
raw = raw:gsub(
	'\tif q == "" then\n\t\t\t\t\tscore = 4\n\t\t\t\telseif lowerPrimary:sub%(1, #q%) == q then',
	'\tif lowerPrimary:sub(1, #q) == q then',
	1
)
raw = raw:gsub(
	'\tlocal y = 0\n\t\tfor index = 1, #matches do\n\t\t\tlocal match = matches%[index%]',
	'\tlocal y = 0\n\t\tif #matches == 0 then\n\t\t\tlocal miss = mk("TextButton", {\n\t\t\t\tBackgroundColor3 = EE_SURFACE,\n\t\t\t\tBorderSizePixel = 0,\n\t\t\t\tSize = UDim2.new(1, 0, 0, 26),\n\t\t\t\tText = T("eeNoCmdMatch"),\n\t\t\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\t\t\tTextTruncate = Enum.TextTruncate.AtEnd,\n\t\t\t\tFont = UI_FONT,\n\t\t\t\tTextSize = 11,\n\t\t\t\tTextColor3 = EE_MUTED,\n\t\t\t\tAutoButtonColor = false,\n\t\t\t\tActive = false,\n\t\t\t\tZIndex = 51,\n\t\t\t}, pickerHolder)\n\t\t\tuiCorner(miss, 6)\n\t\t\tuiPad(miss, 8, 0, 8, 0)\n\t\t\ty = 26\n\t\tend\n\t\tlocal shown = math.min(#matches, 10)\n\t\tfor index = 1, shown do\n\t\t\tlocal match = matches[index]',
	1
)
raw = raw:gsub(
	'setPickerVisible%(#suggestionRows > 0, y%)',
	'setPickerVisible(#suggestionRows > 0 or y > 0, y)',
	1
)

local fn, err = loadstring(raw)
assert(fn, "IYP: compile failed: " .. tostring(err))
return fn()
