function IYR_CLEANUP()
	IYR_GEN = (tonumber(IYR_GEN) or 0) + 1
	local list = IYR_CONNS
	IYR_CONNS = {}
	if type(list) == "table" then
		for i = 1, #list do
			local c = list[i]
			pcall(function()
				if typeof(c) == "RBXScriptConnection" then
					c:Disconnect()
				elseif typeof(c) == "thread" then
					task.cancel(c)
				end
			end)
		end
	end

	local genv = (getgenv and getgenv()) or _G
	pcall(function()
		if type(genv.IYR_CLEAR_ESP) == "function" then
			genv.IYR_CLEAR_ESP()
		elseif type(clearAllESP) == "function" then
			clearAllESP()
		end
	end)
	pcall(function()
		RunService:UnbindFromRenderStep("iyresp")
		RunService:UnbindFromRenderStep("Freecam")
	end)
	pcall(function()
		if type(genv.IYR_STOP_FREECAM) == "function" then genv.IYR_STOP_FREECAM() end
		if type(StopFreecam) == "function" then StopFreecam() end
	end)
	pcall(function()
		if type(genv.IYR_NOFLY) == "function" then genv.IYR_NOFLY() end
		if type(NOFLY) == "function" then NOFLY() end
	end)
	pcall(function()
		local cg = COREGUI or game:GetService("CoreGui")
		for _, v in pairs(cg:GetChildren()) do
			local n = tostring(v.Name)
			if string.sub(n, -4) == "_ESP" or string.sub(n, -5) == "_CHMS" or string.sub(n, -3) == "_LC" then
				v:Destroy()
			end
		end
	end)
	pcall(function()
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("BoxHandleAdornment") and string.sub(tostring(v.Name), -5) == "_PESP" then
				v:Destroy()
			end
		end
	end)
	pcall(function()
		local hooks = genv.IYR_RESET_HOOKS
		if type(hooks) == "table" then
			for i = 1, #hooks do
				pcall(hooks[i])
			end
		end
	end)
	pcall(function()
		local lp = Players and Players.LocalPlayer
		local char = lp and lp.Character
		if char then
			local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
			if root then
				root.Anchored = false
				for _, c in pairs(root:GetChildren()) do
					if c:IsA("BodyVelocity") or c:IsA("BodyGyro") or c:IsA("BodyPosition") then
						c:Destroy()
					end
				end
			end
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then hum.PlatformStand = false end
		end
	end)

	ESPenabled = false
