	local function bindDragSurface(frame, onMove)
		themeTrack(frame.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local moveConn, endConn
			endConn = themeTrack(UserInputService.InputEnded:Connect(function(inp)
				if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
					if moveConn then moveConn:Disconnect() end
					if endConn then endConn:Disconnect() end
				end
			end))
			moveConn = themeTrack(UserInputService.InputChanged:Connect(function(inp)
				if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
					onMove(inp)
				end
			end))
			onMove(input)
		end))
	end

