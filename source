	end

	local function filterSummary(cmd, ev)
		local parts = {}
		for i, set in ipairs(ev.sets or {}) do
			local f = normalizeFilter(cmd[2] and cmd[2][i], set.Type)
			if f.mode and f.mode ~= "any" then
				local inv = f.invert and "NOT " or ""
				local mode = tostring(f.mode)
				local val = tostring(f.value or "")
				local bit = nil
				if set.Type == "Player" and mode == "me" then
					bit = T("eeMeOnly")
				elseif set.Type == "String" and mode == "contains" and val ~= "" then
					bit = (set.Name or "text") .. ' "' .. val .. '"'
				elseif val ~= "" then
					bit = mode .. " " .. val
				else
					bit = mode
				end
				parts[#parts + 1] = inv .. bit
			end
		end
		local meta = getMeta(cmd)
		if (tonumber(meta.cooldown) or 0) > 0 then parts[#parts + 1] = "cd " .. meta.cooldown .. "s" end
		if (tonumber(cmd[3]) or 0) > 0 then parts[#parts + 1] = "delay " .. cmd[3] .. "s" end
		if (tonumber(meta.chance) or 100) < 100 then parts[#parts + 1] = meta.chance .. "%" end
		return #parts > 0 and table.concat(parts, " · ") or T("eeAlways")
	end

