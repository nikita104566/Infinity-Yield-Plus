-- Infinity Yield Plus 7.63
-- One loadstring: boots the 7.50 core from this repo, then adds a clickable
-- favorite star on each command-list row (no second loadstring, no hotfix file).

currentVersion = "7.63"

local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"
local raw
local okGet, errGet = pcall(function()
	raw = game:HttpGet(CORE)
end)
if not okGet or type(raw) ~= "string" or #raw < 1000 then
	error("IYP: failed to load core source (" .. tostring(errGet or "empty") .. ")")
end
local fn, errLoad = loadstring(raw)
if not fn then
	error("IYP: core compile failed (" .. tostring(errLoad) .. ")")
end
fn()

pcall(function()
	currentVersion = "7.63"
	if type(applyHeaderBrand) == "function" then
		applyHeaderBrand()
	elseif VersionLabel then
		VersionLabel.Text = "- " .. tostring(currentVersion)
	end
end)

local function paintStar(btn)
	if not btn then return end
	local star = btn:FindFirstChild("FavStar")
	if not star then return end
	local fav = false
	if type(isFavoriteCmd) == "function" then
		local ok, v = pcall(isFavoriteCmd, btn:GetAttribute("Title") or btn.Text)
		fav = ok and v and true or false
	end
	star.Text = fav and "*" or "o"
	star.TextColor3 = fav and Color3.fromRGB(255, 214, 102) or Color3.fromRGB(154, 148, 176)
end

local function attachStar(btn)
	if not btn or btn:FindFirstChild("FavStar") then
		return
	end
	local label = btn:FindFirstChild("Label")
	if label then
		label.Size = UDim2.new(1, -22, 1, 0)
	end
	local star = Instance.new("TextButton")
	star.Name = "FavStar"
	star.AutoButtonColor = false
	star.BackgroundTransparency = 1
	star.BorderSizePixel = 0
	star.Position = UDim2.new(1, -20, 0, 0)
	star.Size = UDim2.new(0, 20, 1, 0)
	star.Font = Enum.Font.GothamMedium
	star.TextSize = 13
	star.Text = "o"
	star.TextColor3 = Color3.fromRGB(154, 148, 176)
	star.ZIndex = (btn.ZIndex or 10) + 3
	star.Parent = btn
	star.MouseButton1Click:Connect(function()
		if btn.Visible and not btn:GetAttribute("Disabled") and type(toggleFavoriteCmd) == "function" then
			toggleFavoriteCmd(btn:GetAttribute("Title") or btn.Text)
			paintStar(btn)
		end
	end)
	paintStar(btn)
end

pcall(function()
	if type(styleCmdRow) == "function" then
		local prev = styleCmdRow
		styleCmdRow = function(btn)
			local r = prev(btn)
			attachStar(btn)
			return r
		end
	end
	if type(applyFavoriteStyle) == "function" then
		local prevApply = applyFavoriteStyle
		applyFavoriteStyle = function(btn)
			prevApply(btn)
			paintStar(btn)
		end
	end
	if CMDsF then
		for _, child in pairs(CMDsF:GetChildren()) do
			if child:IsA("TextButton") and child.Name == "CMD" then
				attachStar(child)
			end
		end
	end
end)
