        local humanoid = char:WaitForChild("Humanoid",10)
        if not humanoid then return end

        local oldHealth = humanoid.Health
        IYR_TRACK(humanoid.HealthChanged:Connect(function(health)
            local change = math.abs(oldHealth - health)
            if oldHealth > health then
                eventEditor.FireEvent("OnDamage", plr.Name, tonumber(health))
            elseif health > oldHealth then
                eventEditor.FireEvent("OnHeal", plr.Name, tonumber(health), tonumber(change))
            end
            eventEditor.FireEvent("OnHealthBelow", plr.Name, tonumber(health))
            oldHealth = health
        end))

        IYR_TRACK(humanoid.Died:Connect(function()
            eventEditor.FireEvent("OnDied", plr.Name)
            local killedBy = humanoid:FindFirstChild("creator")
            if killedBy and killedBy.Value and killedBy.Value.Parent then
                eventEditor.FireEvent("OnKilled", plr.Name, killedBy.Value.Name)
            end
        end))

        IYR_TRACK(humanoid.StateChanged:Connect(function(_, new)
            if new == Enum.HumanoidStateType.Jumping then
                eventEditor.FireEvent("OnJump", plr.Name)
            elseif new == Enum.HumanoidStateType.Freefall then
                eventEditor.FireEvent("OnFall", plr.Name)
            elseif new == Enum.HumanoidStateType.Landed then
                eventEditor.FireEvent("OnLand", plr.Name)
            end
        end))

        IYR_TRACK(humanoid:GetPropertyChangedSignal("Sit"):Connect(function()
            if humanoid.Sit then
                local seat = humanoid.SeatPart and humanoid.SeatPart.Name or "Seat"
                eventEditor.FireEvent("OnSit", plr.Name, seat)
            end
        end))

        IYR_TRACK(char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                eventEditor.FireEvent("OnTool", plr.Name, child.Name)
            end
        end))
        IYR_TRACK(char.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then
                eventEditor.FireEvent("OnToolRemoved", plr.Name, child.Name)
            end
        end))
        IYR_TRACK(humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            eventEditor.FireEvent("OnWalkSpeed", plr.Name, humanoid.WalkSpeed)
        end))
        if plr == Players.LocalPlayer then
            local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if hrp then
                IYR_TRACK(hrp.Touched:Connect(function(part)
                    if part then
                        eventEditor.FireEvent("OnTouched", part.Name)
                    end
                end))
            end
        end
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped then
            eventEditor.FireEvent("OnTool", plr.Name, equipped.Name)
        end
    end)
end

local _eeChatDedupe = {}
local function fireOnChatted(playerName, msg)
    local key = tostring(playerName) .. "\0" .. tostring(msg)
    local now = tick()
    local prev = _eeChatDedupe[key]
    if prev and (now - prev) < 0.05 then return end
    _eeChatDedupe[key] = now
    task.delay(1, function()
        if _eeChatDedupe[key] == now then _eeChatDedupe[key] = nil end
    end)
    eventEditor.FireEvent("OnChatted", playerName, msg)
end

