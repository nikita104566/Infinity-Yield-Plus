-- Infinity Yield Plus 7.63
-- One loadstring. Fetches the last full core and applies the copyurl hunk in memory.
local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"

local function replace_once(src, old, new)
	local i, j = string.find(src, old, 1, true)
	if not i then
		error("IYP 7.63: missing source hunk: " .. string.sub(old, 1, 48))
	end
	return string.sub(src, 1, i - 1) .. new .. string.sub(src, j + 1)
end

local raw = game:HttpGet(CORE)
raw = replace_once(raw, "currentVersion = '7.50'", "currentVersion = '7.63'")
raw = replace_once(
	raw,
	"CMDs[#CMDs + 1] = {NAME = 'copygameid / gameid', DESC = 'Copies the current game id to your clipboard'}",
	"CMDs[#CMDs + 1] = {NAME = 'copygameid / gameid', DESC = 'Copies the current game id to your clipboard'}\nCMDs[#CMDs + 1] = {NAME = 'copyurl / placeurl / gameurl', DESC = 'Copies the Roblox game URL and shows it'}"
)
raw = replace_once(
	raw,
	'addcmd("copygameid", {"gameid"}, function(args, speaker)\n    toClipboard(game.GameId)\nend)',
	'addcmd("copygameid", {"gameid"}, function(args, speaker)\n    toClipboard(game.GameId)\nend)\n\naddcmd("copyurl", {"placeurl", "gameurl"}, function(args, speaker)\n\tlocal url = "https://www.roblox.com/games/" .. tostring(PlaceId)\n\tif everyClipboard then\n\t\teveryClipboard(url)\n\tend\n\tnotify(T("copyUrlTitle"), url)\nend)'
)
raw = replace_once(
	raw,
	'\toutdatedBody = "Get the new version by executing it again",',
	'\toutdatedBody = "Get the new version by executing it again",\n\t\tcopyUrlTitle = "Place URL",'
)
raw = replace_once(
	raw,
	'\toutdatedBody = "Запусти скрипт ещё раз",',
	'\toutdatedBody = "Запусти скрипт ещё раз",\n\t\tcopyUrlTitle = "Ссылка на плейс",'
)
raw = replace_once(
	raw,
	"\t\t-- IYP_RU_EXTRA_END",
	"\t\tcopyurl = 'Копирует ссылку на плейс и показывает её',\n\t\t-- IYP_RU_EXTRA_END"
)

assert(loadstring(raw))()
