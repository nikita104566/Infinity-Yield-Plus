-- Infinity Yield Plus 7.63
-- One loadstring. Same environment as the 7.50 core (commit e30e0ec).
-- Down on an empty command bar highlights the list; Up still walks history until a row is painted.

local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"

local ok, raw = pcall(function()
	return game:HttpGet(CORE)
end)
if not ok or type(raw) ~= "string" or #raw < 1000 then
	error("IYP 7.63: could not load core source")
end

do
	local i, j = string.find(raw, "currentVersion = '7.50'", 1, true)
	if i then
		raw = raw:sub(1, i - 1) .. "currentVersion = '7.63'" .. raw:sub(j + 1)
	end
end

local OLD = [=[            if input.KeyCode == Enum.KeyCode.Up then
                if Cmdbar.Text ~= "" and #visibleCmdButtons > 0 then
                    moveCmdSelection(-1)
                else
                historyCount += 1
                if historyCount > #cmdHistory then historyCount = #cmdHistory end
                Cmdbar.Text = cmdHistory[historyCount] or ""
                Cmdbar.CursorPosition = 1020
                end
            elseif input.KeyCode == Enum.KeyCode.Down then
                if Cmdbar.Text ~= "" and #visibleCmdButtons > 0 then
                    moveCmdSelection(1)
                else
                historyCount = historyCount - 1
                if historyCount < 0 then historyCount = 0 end
                Cmdbar.Text = cmdHistory[historyCount] or ""
                Cmdbar.CursorPosition = 1020
                end]=]

local NEW = [=[            if input.KeyCode == Enum.KeyCode.Up then
                if cmdSelectionPainted and #visibleCmdButtons > 0 then
                    moveCmdSelection(-1)
                elseif Cmdbar.Text ~= "" and #visibleCmdButtons > 0 then
                    moveCmdSelection(-1)
                else
                historyCount += 1
                if historyCount > #cmdHistory then historyCount = #cmdHistory end
                Cmdbar.Text = cmdHistory[historyCount] or ""
                Cmdbar.CursorPosition = 1020
                end
            elseif input.KeyCode == Enum.KeyCode.Down then
                if cmdSelectionPainted and #visibleCmdButtons > 0 then
                    moveCmdSelection(1)
                elseif #visibleCmdButtons > 0 then
                    if not cmdSelectionPainted then
                        cmdSelectionPainted = true
                        if not selectedCmdIndex or selectedCmdIndex < 1 then
                            selectedCmdIndex = 1
                        end
                        selectedCmdButton = visibleCmdButtons[selectedCmdIndex]
                        applyCmdSelection()
                    else
                        moveCmdSelection(1)
                    end
                else
                historyCount = historyCount - 1
                if historyCount < 0 then historyCount = 0 end
                Cmdbar.Text = cmdHistory[historyCount] or ""
                Cmdbar.CursorPosition = 1020
                end]=]

local i, j = string.find(raw, OLD, 1, true)
if not i then
	error("IYP 7.63: command-bar arrow hunk not found in core")
end
local patched = raw:sub(1, i - 1) .. NEW .. raw:sub(j + 1)

local fn, err = loadstring(patched)
if not fn then
	error("IYP 7.63: " .. tostring(err))
end
fn()
