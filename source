local function getcustomasset(asset)
    local fallback = iyrassets[asset]
    local fileName = tostring(asset or ""):match("([^/\\]+)$") or asset
    local localPath = "infiniteyieldreborn/assets/" .. tostring(fileName)

    -- Only use executor getcustomasset for real on-disk files.
    -- Never pass fake paths like "IYR.LOL/assets/..." — they can return
    -- empty/broken content ids and hide icons forever.
    if waxgetcustomasset and isfile and readfile and isfile(localPath) then
        local okData, data = pcall(readfile, localPath)
        if okData and type(data) == "string" and #data > 200 and not string.match(data, "^%s*<") then
            local ok, result = pcall(waxgetcustomasset, localPath)
            if ok and type(result) == "string" and result ~= "" then
                return result
            end
        end
    end

    return fallback
end

if makefolder and isfolder and writefile and isfile and readfile then
    pcall(function()
        local assetsURL = "https://raw.githubusercontent.com/infyiff/backup/refs/heads/main/"
        local logoURL = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/main/logo.png"
        local logoVer = "iyp-5"
        local targetFolder = "infiniteyieldreborn/assets"
        local sourceFolder = "infiniteyield/assets"

        local function looksLikeAsset(content)
            return type(content) == "string" and #content > 200 and not string.match(content, "^%s*<")
        end

        if not isfolder("infiniteyieldreborn") then makefolder("infiniteyieldreborn") end
        if not isfolder(targetFolder) then makefolder(targetFolder) end

        for path, _ in pairs(iyrassets) do
            local fileName = path:gsub("IYR.LOL/assets/", "")
            local localSource = sourceFolder .. "/" .. fileName
            local localTarget = targetFolder .. "/" .. fileName

            if not isfile(localTarget) then
                if isfile(localSource) then
                    local ok, content = pcall(readfile, localSource)
                    if ok and looksLikeAsset(content) then
                        writefile(localTarget, content)
                    end
                else
                    local downloadURL = assetsURL .. "assets/" .. fileName
                    local success, content = pcall(function() return game:HttpGet(downloadURL) end)
                    if success and looksLikeAsset(content) then
                        writefile(localTarget, content)
                    end
                end
            elseif isfile(localTarget) then
                -- Drop tiny/HTML junk left by failed downloads so rbxassetid fallback wins
                local ok, content = pcall(readfile, localTarget)
                if not (ok and looksLikeAsset(content)) then
                    pcall(function()
                        if delfile then delfile(localTarget) end
                    end)
                end
            end
        end

        -- Always refresh splash logo for Infinity Yield Plus branding
        do
            local logoPath = targetFolder .. "/logo.png"
            local verPath = targetFolder .. "/logo.ver"
            local needLogo = (not isfile(logoPath)) or (not isfile(verPath)) or (readfile(verPath) ~= logoVer)
            if needLogo then
                local content = nil
                for _, candidate in ipairs({ "logo.png", "iyp-logo.png", "assets/logo-splash.png" }) do
                    if isfile(candidate) then
                        local ok, data = pcall(readfile, candidate)
                        if ok and looksLikeAsset(data) and #data > 1000 then
                            content = data
                            break
                        end
                    end
                end
                if not content then
                    local ok, data = pcall(function() return game:HttpGet(logoURL) end)
                    if ok and looksLikeAsset(data) and #data > 1000 then
                        content = data
                    end
                end
                if content then
                    writefile(logoPath, content)
                    writefile(verPath, logoVer)
                end
            end
        end

        if IsOnMobile then 
            writefile(targetFolder .. "/.nomedia", "") 
        end
    end)
end

