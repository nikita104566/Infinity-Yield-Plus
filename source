    local function consider(label, value, desc)
        local lv, ll = value:lower(), label:lower()
        if q == "" or lv:sub(1, #q) == q or ll:find(q, 1, true) then
            results[#results + 1] = {label = label, value = value, desc = desc}
        end
    end
    consider("me", "me", T("yourself"))
    consider("all", "all", T("everyone"))
    consider("others", "others", T("everyoneExcept"))
    consider("random", "random", T("randomPlayer"))
    for _, plr in ipairs(Players:GetPlayers()) do
        local label = (plr.DisplayName ~= plr.Name) and (plr.Name .. " (" .. plr.DisplayName .. ")") or plr.Name
        consider(label, plr.Name, T("player"))
    end
    return results
end

IndexContents = function(str,bool,cmdbar,Ianim)
    if not keepCmdSelection then
    CMDsF.CanvasPosition = Vector2.new(0,0)
    end
    local indexnum = 0
    local frame = CMDsF
    topCommand = nil
    selectedCmdButton = nil
    visibleCmdButtons = {}
    local chunks = {}
    if str:sub(#str,#str) == "\\" then str = "" end
    for w in string.gmatch(str,"[^\\]+") do
        table.insert(chunks,w)
    end
    if #chunks > 0 then str = chunks[#chunks] end
    if str:sub(1,1) == "!" then str = str:sub(2) end

    local hasSpace = str:find("%s") ~= nil
    local cmdQuery = str
    local argQuery = ""
    if hasSpace then
        cmdQuery = str:match("^(%S+)") or str
        if str:sub(-1, -1) == " " then
            argQuery = ""
        else
            argQuery = str:match("(%S+)$") or ""
        end
    end

    hidePlayerSuggest()

    local ranked = {}
    for _, v in next, frame:GetChildren() do
        if v:IsA("TextButton") and v.Name ~= "IYR_SUGGEST" then
            local score = 0
            if not bool then
                score = 1
            elseif hasSpace then
                local first = (v.Text:match("^%S+") or v.Text):lower()
                if first == cmdQuery:lower() then
                    score = 800
                    end
                else
                score = commandScore(v.Text, str)
            end
            if score > 0 and v.Text ~= "" then
                ranked[#ranked + 1] = {btn = v, score = score}
            else
                v.Visible = false
                setCmdRowSelected(v, false)
            end
        end
    end
    table.sort(ranked, function(a, b)
        if a.score == b.score then
            return a.btn.Text < b.btn.Text
        end
        return a.score > b.score
    end)

    local takesPlayer = false
    if hasSpace and ranked[1] then
        local usage = ranked[1].btn.Text:lower()
        takesPlayer = usage:find("[player]", 1, true) or usage:find("[plr]", 1, true) or usage:find("player", 1, true)
    end

    local favRanked, otherRanked = {}, {}
    if takesPlayer then
        otherRanked = ranked
    else
        for _, item in ipairs(ranked) do
            local favIdx
            if type(isFavoriteCmd) == "function" then
                local isFav, idx = isFavoriteCmd(item.btn:GetAttribute("Title") or item.btn.Text)
                if isFav then favIdx = idx end
            end
            if favIdx then
                item.favIdx = favIdx
                favRanked[#favRanked + 1] = item
            else
                otherRanked[#otherRanked + 1] = item
            end
        end
        table.sort(favRanked, function(a, b)
            if a.favIdx ~= b.favIdx then return a.favIdx < b.favIdx end
            return a.btn.Text < b.btn.Text
        end)
    end

    if cmdFavHeader then
        cmdFavHeader.Visible = not takesPlayer and #favRanked > 0
        cmdFavHeader.LayoutOrder = 1
    end
    if cmdAllHeader then
        cmdAllHeader.Visible = not takesPlayer and #favRanked > 0 and #otherRanked > 0
        cmdAllHeader.LayoutOrder = 500
    end

    local function placeCmdRow(item, order)
        indexnum += 1
        item.btn.Visible = true
        item.btn.LayoutOrder = order
        if type(applyFavoriteStyle) == "function" then
            applyFavoriteStyle(item.btn)
        end
        visibleCmdButtons[#visibleCmdButtons + 1] = item.btn
        if topCommand == nil then
            topCommand = item.btn.Text
        end
    end

    local layout = 2
    for _, item in ipairs(favRanked) do
        placeCmdRow(item, layout)
        layout += 1
    end
    layout = 501
    for _, item in ipairs(otherRanked) do
        placeCmdRow(item, layout)
        layout += 1
    end
    if takesPlayer then
        local suggestions = collectPlayerSuggestions(argQuery)
        for i, sug in ipairs(suggestions) do
            if i > 24 then break end
            local btn = getPlayerSuggestButton(i)
            btn.Text = sug.label
            applyCmdRowText(btn, sug.label)
            btn:SetAttribute("Title", sug.label)
            btn:SetAttribute("Desc", sug.desc)
            btn:SetAttribute("SuggestKind", "player")
            btn:SetAttribute("SuggestValue", sug.value)
            btn.LayoutOrder = i
