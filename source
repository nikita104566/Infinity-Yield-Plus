-- Infinity Yield Plus 7.63
-- One loadstring: frozen core + command-row readability.
local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"
local raw
do
	local ok, res = pcall(function()
		return game:HttpGet(CORE)
	end)
	if not ok or type(res) ~= "string" or #res < 1000 then
		error("IYP: failed to fetch core source")
	end
	raw = res
end
local fn, err = loadstring(raw)
if not fn then
	error("IYP: core compile failed: " .. tostring(err))
end
fn()

pcall(function()
	currentVersion = "7.63"
	if type(applyHeaderBrand) == "function" then
		applyHeaderBrand()
	elseif VersionLabel then
		VersionLabel.Text = "· 7.63"
	end
	if SubLabel then
		SubLabel.Text = "7.63"
	end
end)

function splitCmdDisplay(text)
	local rawText = tostring(text or "")
	if rawText == "" then
		return "", ""
	end
	local argAt = rawText:find("%[")
	local names = rawText
	local args = ""
	if argAt then
		names = rawText:sub(1, argAt - 1):gsub("%s+$", "")
		args = rawText:sub(argAt)
	end
	local primary, aliases = names:match("^([^/]+)%s*(.*)$")
	primary = (primary or names):gsub("%s+$", "")
	aliases = aliases or ""
	local meta = aliases
	if args ~= "" then
		if meta ~= "" then
			meta = meta .. " " .. args
		else
			meta = args
		end
	end
	return primary, meta
end

function formatCmdRich(text)
	if not text or text == "" then
		return ""
	end
	local primary, meta = splitCmdDisplay(text)
	local function esc(v)
		return tostring(v):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	end
	local html = "<font color=\"#B8B4CC\">·</font> <font color=\"#F4F4F8\">" .. esc(primary) .. "</font>"
	if meta ~= "" then
		html = html .. "<font color=\"#7A778C\"> " .. esc(meta) .. "</font>"
	end
	return html
end

function applyCmdRowText(btn, text)
	if not btn then
		return
	end
	btn.Text = text
	local label = btn:FindFirstChild("Label")
	local metaLbl = btn:FindFirstChild("Meta")
	if not label then
		return
	end
	if btn:GetAttribute("SuggestKind") == "player" then
		label.Text = tostring(text or "")
		label.RichText = false
		label.Size = UDim2.new(1, 0, 1, 0)
		label.Position = UDim2.new(0, 0, 0, 0)
		if metaLbl then
			metaLbl.Visible = false
			metaLbl.Text = ""
		end
		return
	end
	local primary, meta = splitCmdDisplay(text)
	label.RichText = false
	label.Text = primary
	label.TextTruncate = Enum.TextTruncate.None
	if metaLbl then
		if meta ~= "" then
			metaLbl.Text = meta
			metaLbl.Visible = true
			label.Size = UDim2.new(1, 0, 0, 18)
			label.Position = UDim2.new(0, 0, 0, 2)
		else
			metaLbl.Text = ""
			metaLbl.Visible = false
			label.Size = UDim2.new(1, 0, 1, 0)
			label.Position = UDim2.new(0, 0, 0, 0)
		end
	end
end

local function ensureMeta(btn)
	if not btn or btn:FindFirstChild("Meta") then
		return
	end
	local label = btn:FindFirstChild("Label")
	if label then
		label.RichText = false
		label.Font = UI_FONT_MED or label.Font
		label.TextTruncate = Enum.TextTruncate.None
	end
	local meta = Instance.new("TextLabel")
	meta.Name = "Meta"
	meta.BackgroundTransparency = 1
	meta.Size = UDim2.new(1, 0, 0, 14)
	meta.Position = UDim2.new(0, 0, 0, 20)
	meta.Font = UI_FONT or Enum.Font.Gotham
	meta.TextSize = 11
	meta.TextXAlignment = Enum.TextXAlignment.Left
	meta.TextColor3 = Color3.fromRGB(122, 119, 140)
	meta.RichText = false
	meta.TextTruncate = Enum.TextTruncate.AtEnd
	meta.ZIndex = 11
	meta.Parent = btn
end

pcall(function()
	if Example then
		Example.Size = UDim2.new(1, -((SCROLL_GUTTER or 12) + 2), 0, 38)
	end
end)

pcall(function()
	if not CMDsF then
		return
	end
	for _, child in pairs(CMDsF:GetChildren()) do
		if child:IsA("TextButton") and child.Name ~= "IYR_SUGGEST" then
			child.Size = UDim2.new(1, -((SCROLL_GUTTER or 12) + 2), 0, 38)
			ensureMeta(child)
			applyCmdRowText(child, child:GetAttribute("Title") or child.Text)
			if type(FavCmds) == "table" and type(FavCmds.apply) == "function" then
				FavCmds.apply(child)
			end
			local meta = child:FindFirstChild("Meta")
			local fav = type(FavCmds) == "table" and type(FavCmds.is) == "function" and FavCmds.is(child:GetAttribute("Title") or child.Text)
			if meta then
				meta.TextColor3 = fav and Color3.fromRGB(186, 154, 72) or Color3.fromRGB(122, 119, 140)
			end
		end
	end
end)
