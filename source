addcmd("printglobals", {"printg", "getglobals", "getg"}, function(args, speaker)
    if #args < 1 then
        notify("Error", "Usage: printglobals [container].[globalname] or [container] or all [custom] [depth=3]")
        return
    end

    local fullPath = args[1]
    local filterCustom = args[2] == "custom"
    local maxDepth = tonumber(args[3]) or 3
    local containerName, globalName = fullPath:match("^([^.]+)%.(.+)$") or fullPath, nil
    containerName = containerName:gsub("%(%)", "")

    local function dumpTable(t, name, depth, currentDepth)
        if currentDepth > depth then return end
        local sortedKeys = {}
        for k in pairs(t) do table.insert(sortedKeys, k) end
        table.sort(sortedKeys)
        for _, k in ipairs(sortedKeys) do
            local v = t[k]
            if filterCustom and (type(k) == "string" and k:match("^_") or type(v) == "function" and debug.getinfo(v).name == "") then continue end  -- Skip builtins if custom
            print(string.format("[%s.%s] = %s (%s)", name, tostring(k), tostring(v), type(v)))
            if type(v) == "table" then
                dumpTable(v, name .. "." .. tostring(k), depth, currentDepth + 1)
            end
        end
    end

    if containerName == "all" then
        for envName, envTable in pairs(availableEnvs) do
            if envTable then
                print("-- Globals for:", envName)
                task.spawn(function()  -- Async to avoid freeze
                    dumpTable(envTable, envName, maxDepth, 1)
                end)
                notify("Console", "Dumping to console; press F9")
            end
        end
    else
        local env = availableEnvs[containerName]
        if env then
            if globalName then
                local value = env[globalName]
                if value ~= nil then
                    print(string.format("[%s.%s] = %s (%s)", containerName, globalName, tostring(value), type(value)))
                    if type(value) == "table" then dumpTable(value, containerName .. "." .. globalName, maxDepth, 1) end
                    notify("Global Found", string.format("%s.%s = %s", containerName, globalName, tostring(value)))
                else
                    notify("Global Not Found", string.format("'%s' does not exist in %s.", globalName, containerName))
                end
            else
                print("🔹 Globals for:", containerName)
                task.spawn(function()
                    dumpTable(env, containerName, maxDepth, 1)
                end)
                notify("Console", "Dumping to console; press F9")
            end
        else
            notify("Error", string.format("Container '%s' does not exist or is inaccessible.", containerName))
        end
    end
end)

