-- Infinity Yield Plus 7.63
-- One player loadstring. Applies command-bar clear button onto the pinned 7.50 core.
local CORE_URL = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"
local okGet, raw = pcall(function()
	return game:HttpGet(CORE_URL)
end)
if not okGet or type(raw) ~= "string" or #raw < 100000 then
	error("[IYP] failed to load core source")
end

raw = raw:gsub("currentVersion = '7%.50'", "currentVersion = '7.63'", 1)

local function applyOnce(src, needle, repl, tag)
	local i, j = string.find(src, needle, 1, true)
	if not i then
		error("[IYP] missing anchor: " .. tag)
	end
	return string.sub(src, 1, i - 1) .. repl .. string.sub(src, j + 1)
end

raw = applyOnce(raw,
	"Cmdbar.ClearTextOnFocus = false",
	"Cmdbar.ClearTextOnFocus = false\nCmdbar.Size = UDim2.new(1, -36, 1, 0)\ndo\n\tlocal clearBtn = Instance.new(\"TextButton\")\n\tclearBtn.Name = \"CmdClear\"\n\tclearBtn.AutoButtonColor = false\n\tclearBtn.BackgroundTransparency = 1\n\tclearBtn.BorderSizePixel = 0\n\tclearBtn.Size = UDim2.new(0, 22, 1, 0)\n\tclearBtn.Position = UDim2.new(1, -24, 0, 0)\n\tclearBtn.Font = UI_FONT\n\tclearBtn.TextSize = 16\n\tclearBtn.Text = \"x\"\n\tclearBtn.TextColor3 = Color3.fromRGB(180, 180, 190)\n\tclearBtn.Visible = false\n\tclearBtn.ZIndex = 12\n\tclearBtn.Parent = CmdbarWrap\n\tlocal function syncCmdClear()\n\t\tlocal t = Cmdbar.Text or \"\"\n\t\tclearBtn.Visible = t ~= \"\"\n\tend\n\tclearBtn.MouseButton1Click:Connect(function()\n\t\tCmdbar.Text = \"\"\n\t\tsyncCmdClear()\n\t\tpcall(function()\n\t\t\tCmdbar:CaptureFocus()\n\t\tend)\n\t\tif type(scheduleIndexContents) == \"function\" then\n\t\t\tscheduleIndexContents(\"\", true, true)\n\t\tend\n\tend)\n\tCmdbar:GetPropertyChangedSignal(\"Text\"):Connect(syncCmdClear)\n\tsyncCmdClear()\nend",
	"cmdClear")

local fn, err = loadstring(raw)
if not fn then
	error("[IYP] compile failed: " .. tostring(err))
end
return fn()
