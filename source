			if not cmd[2] then cmd[2] = {} end
			cmd[2][i] = normalizeFilter(cmd[2][i], set.Type)
			local f = cmd[2][i]
			section((set.Name or ("Arg " .. i)))
			if set.Type == "Player" then
				cycle("Mode", { "any", "me", "others", "friend", "nonfriend", "team", "allies", "enemies", "nonteam", "alive", "dead", "named", "display", "inradius", "group", "whitelist", "blacklist", "age", "custom" }, f.mode or "any", function(v)
