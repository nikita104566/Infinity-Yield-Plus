function updateESP(playerName, esp)
    if type(esp) ~= "table" or esp.fallback or not esp.box then return end
    local cam = workspace.CurrentCamera
    if not cam then
        hideESPDrawings(esp)
        return
    end

    local player = Players:FindFirstChild(playerName)
    if not player then
        hideESPDrawings(esp)
        return
    end

    if ESPteamOnly then
        local lp = Players.LocalPlayer
        if lp.Team and player.Team and player.Team == lp.Team then
            hideESPDrawings(esp)
            return
        end
    end
    
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char.PrimaryPart)
    if not char or not char.Parent or not root or not hum or hum.Health <= 0 then
        hideESPDrawings(esp)
        return
    end
    
    local screenPos, onScreen = cam:WorldToViewportPoint(root.Position)
    local depth = screenPos.Z
    if (not onScreen) or depth <= 1 then
        hideESPDrawings(esp)
        return
    end

    local fov = cam.FieldOfView
    if fov < 1 then fov = 70 end
    local sf = 1000 / (depth * math.tan(math.rad(fov / 2)) * 2)
    if sf ~= sf or sf == math.huge then
        hideESPDrawings(esp)
        return
    end

    local w = math.clamp(math.round(4 * sf), 6, 350)
    local h = math.clamp(math.round(5 * sf), 8, 500)
    local x = math.round(screenPos.X)
    local y = math.round(screenPos.Y)
    local boxPos = Vector2.new(x - w / 2, y - h / 2)
    local teamColor = (player.TeamColor and player.TeamColor.Color) or Color3.fromRGB(255, 80, 80)

    pcall(function()
        esp.box.Size = Vector2.new(w, h)
        esp.box.Position = boxPos
        esp.box.Color = teamColor
        esp.box.Visible = true
        
        esp.boxl.Size = Vector2.new(w, h)
        esp.boxl.Position = boxPos
        esp.boxl.Visible = true
        
        local hp = 0
        if hum.MaxHealth > 0 then
            hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        end
        local barH = math.max(1, h * hp)
        esp.healthbar.Size = Vector2.new(2, barH)
        esp.healthbar.Position = Vector2.new(x - w / 2 - 6, y - h / 2 + (h - barH))
        esp.healthbar.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 40)
            esp.healthbar.Visible = true
            
            esp.healthbarl.Size = Vector2.new(4, h)
        esp.healthbarl.Position = Vector2.new(x - w / 2 - 7, y - h / 2)
            esp.healthbarl.Visible = true

        local shownName = player.Name
        if player.DisplayName and player.DisplayName ~= player.Name then
            shownName = player.DisplayName .. " (@" .. player.Name .. ")"
        end
        esp.name.Text = shownName
        esp.name.Position = Vector2.new(x, y - h / 2 - 16)
        esp.name.Visible = true
        
        local lpChar = Players.LocalPlayer.Character
        local lpRoot = lpChar and (lpChar:FindFirstChild("HumanoidRootPart") or lpChar.PrimaryPart)
        local dist = lpRoot and math.round((root.Position - lpRoot.Position).Magnitude) or math.round(depth)
        esp.distance.Text = tostring(dist) .. " studs"
        esp.distance.Position = Vector2.new(x, y + h / 2 + 4)
        esp.distance.Visible = true
    end)
end

