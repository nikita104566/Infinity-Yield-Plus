-- Russian command descriptions keyed by primary command name
CMD_DESC_RU = CMD_DESC_RU or {}
function registerRuDesc(name, text)
	if type(name) == "string" and type(text) == "string" and name ~= "" then
		CMD_DESC_RU[name:lower()] = text
	end
end

function cmdPrimaryKey(title)
	local raw = tostring(title or "")
	local first = raw:match("^%S+") or raw
	first = first:gsub("%[.-%]", "")
	first = first:match("^([^/]+)") or first
	return (first:gsub("%s+$", "")):lower()
end

