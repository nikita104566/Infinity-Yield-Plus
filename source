-- Infinity Yield Plus 7.63
-- One user loadstring. Fetches the 7.50 Studio core, then registers
-- showhistory / clearhistory and a safe lastcommand in the same environment.

local CORE = "https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source"

local raw
do
	local ok, res = pcall(function()
		return game:HttpGet(CORE)
	end)
	if ok and type(res) == "string" and #res > 1000 then
		raw = res
	end
end
if not raw then
	error("Infinity Yield Plus: failed to fetch core source")
end

local fn, err = loadstring(raw)
if type(fn) ~= "function" then
	error("Infinity Yield Plus: core compile failed: " .. tostring(err))
end
fn()

pcall(function()
	currentVersion = "7.63"
	if type(applyHeaderBrand) == "function" then
		applyHeaderBrand()
	elseif VersionLabel then
		VersionLabel.Text = "· 7.63"
	end
	if SubLabel then
		SubLabel.Text = "7.63"
	end
end)

pcall(function()
	if type(UI_L) ~= "table" then
		return
	end
	if type(UI_L.en) == "table" then
		UI_L.en.histTitle = UI_L.en.histTitle or "History"
		UI_L.en.histEmpty = UI_L.en.histEmpty or "History is empty"
		UI_L.en.histCleared = UI_L.en.histCleared or "History"
		UI_L.en.histClearedText = UI_L.en.histClearedText or "Command history cleared"
		UI_L.en.lastCmdEmpty = UI_L.en.lastCmdEmpty or "History"
		UI_L.en.lastCmdEmptyText = UI_L.en.lastCmdEmptyText or "No previous command yet"
	end
	if type(UI_L.ru) == "table" then
		UI_L.ru.histTitle = UI_L.ru.histTitle or "История"
		UI_L.ru.histEmpty = UI_L.ru.histEmpty or "История пуста"
		UI_L.ru.histCleared = UI_L.ru.histCleared or "История"
		UI_L.ru.histClearedText = UI_L.ru.histClearedText or "История команд очищена"
		UI_L.ru.lastCmdEmpty = UI_L.ru.lastCmdEmpty or "История"
		UI_L.ru.lastCmdEmptyText = UI_L.ru.lastCmdEmptyText or "Пока нет предыдущей команды"
	end
end)

local function alreadyListed(needle)
	if type(CMDs) ~= "table" then
		return false
	end
	needle = string.lower(needle)
	for i = 1, #CMDs do
		local row = CMDs[i]
		local name = type(row) == "table" and tostring(row.NAME or "") or ""
		if string.find(string.lower(name), needle, 1, true) then
			return true
		end
	end
	return false
end

pcall(function()
	if type(CMDs) ~= "table" then
		return
	end
	if not alreadyListed("showhistory") then
		CMDs[#CMDs + 1] = { NAME = "showhistory / hist / cmdhistory", DESC = "Shows the last saved commands" }
	end
	if not alreadyListed("clearhistory") then
		CMDs[#CMDs + 1] = { NAME = "clearhistory / clrhist / wipehistory", DESC = "Clears saved command history" }
	end
	if type(registerRuDesc) == "function" then
		registerRuDesc("showhistory", "Показывает последние сохранённые команды")
		registerRuDesc("hist", "Показывает последние сохранённые команды")
		registerRuDesc("cmdhistory", "Показывает последние сохранённые команды")
		registerRuDesc("clearhistory", "Очищает сохранённую историю команд")
		registerRuDesc("clrhist", "Очищает сохранённую историю команд")
		registerRuDesc("wipehistory", "Очищает сохранённую историю команд")
		registerRuDesc("lastcommand", "Выполняет предыдущую команду")
		registerRuDesc("lastcmd", "Выполняет предыдущую команду")
	end
end)

pcall(function()
	local g = (type(getgenv) == "function" and getgenv()) or _G
	if type(addcmdtext) == "function" and type(g) == "table" and not g.__IYP_763_HIST_ROWS then
		g.__IYP_763_HIST_ROWS = true
		addcmdtext("showhistory / hist / cmdhistory", "showhistory", "Shows the last saved commands")
		addcmdtext("clearhistory / clrhist / wipehistory", "clearhistory", "Clears saved command history")
	end
end)

pcall(function()
	if type(addcmd) ~= "function" then
		return
	end
	addcmd("showhistory", { "hist", "cmdhistory" }, function()
		local title = (type(T) == "function" and T("histTitle")) or "History"
		if type(cmdHistory) ~= "table" or #cmdHistory == 0 then
			if type(notify) == "function" then
				notify(title, (type(T) == "function" and T("histEmpty")) or "History is empty")
			end
			return
		end
		local start = math.max(1, #cmdHistory - 7)
		local lines = {}
		for i = start, #cmdHistory do
			lines[#lines + 1] = tostring(i) .. ". " .. tostring(cmdHistory[i])
		end
		if type(notify) == "function" then
			notify(title, table.concat(lines, "\n"))
		end
	end)
	addcmd("clearhistory", { "clrhist", "wipehistory" }, function()
		if type(cmdHistory) == "table" then
			if type(table.clear) == "function" then
				table.clear(cmdHistory)
			else
				for i = #cmdHistory, 1, -1 do
					cmdHistory[i] = nil
				end
			end
		else
			cmdHistory = {}
		end
		if type(updatesaves) == "function" then
			pcall(updatesaves)
		end
		if type(notify) == "function" then
			notify(
				(type(T) == "function" and T("histCleared")) or "History",
				(type(T) == "function" and T("histClearedText")) or "Command history cleared"
			)
		end
	end)
	addcmd("lastcommand", { "lastcmd" }, function()
		local last = type(cmdHistory) == "table" and cmdHistory[1]
		if type(last) ~= "string" or last == "" then
			if type(notify) == "function" then
				notify(
					(type(T) == "function" and T("lastCmdEmpty")) or "History",
					(type(T) == "function" and T("lastCmdEmptyText")) or "No previous command yet"
				)
			end
			return
		end
		local tok = string.lower((string.match(last, "^%s*;?%s*(%S+)") or ""))
		if tok ~= "lastcommand" and tok ~= "lastcmd" and type(execCmd) == "function" then
			execCmd(last)
		elseif type(notify) == "function" then
			notify(
				(type(T) == "function" and T("lastCmdEmpty")) or "History",
				(type(T) == "function" and T("lastCmdEmptyText")) or "No previous command yet"
			)
		end
	end)
end)
