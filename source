function FavCmds.fly(btn, fromAbs, fromSize, adding)
	if not (btn and Holder and fromAbs and TweenService) then return end
	pcall(function()
		for _, g in pairs(Holder:GetChildren()) do
			if g.Name == "IYR_FAV_GHOST" then g:Destroy() end
		end
	end)
	local ghost = btn:Clone()
	ghost.Name = "IYR_FAV_GHOST"
	ghost.Parent = Holder
	ghost.Visible = true
	ghost.Active = false
	ghost.AutoButtonColor = false
	ghost.ZIndex = 24
	local hs = Holder.AbsolutePosition
	local w = (fromSize and fromSize.X) or btn.AbsoluteSize.X
	local h = (fromSize and fromSize.Y) or btn.AbsoluteSize.Y
	ghost.Size = UDim2.fromOffset(w, h)
	ghost.Position = UDim2.fromOffset(fromAbs.X - hs.X, fromAbs.Y - hs.Y)
	local label = btn:FindFirstChild("Label")
	if label then label.TextTransparency = 1 end
	btn.BackgroundTransparency = 1
	local gold = Color3.fromRGB(255, 214, 102)
	local ghostLabel = ghost:FindFirstChild("Label")
	if ghostLabel and adding then
		ghostLabel.TextColor3 = gold
	end
	task.defer(function()
		pcall(function()
			RunService.Heartbeat:Wait()
		end)
		if introDone == false and IntroBackground and IntroBackground.Parent then
			if label then label.TextTransparency = 0 end
			btn.BackgroundTransparency = 1
			pcall(function() ghost:Destroy() end)
			FavCmds.apply(btn)
			return
		end
		if not (btn and btn.Parent) then
			pcall(function() ghost:Destroy() end)
			return
		end
		local to = btn.AbsolutePosition
		local hs2 = Holder.AbsolutePosition
		local dx = to.X - fromAbs.X
		local dy = to.Y - fromAbs.Y
		if (dx * dx + dy * dy) < 64 then
			pcall(function() ghost:Destroy() end)
			if label then label.TextTransparency = 0 end
			FavCmds.apply(btn)
			return
		end
		local info = TweenInfo.new(0.34, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		local move = TweenService:Create(ghost, info, {
			Position = UDim2.fromOffset(to.X - hs2.X, to.Y - hs2.Y),
		})
		move:Play()
		move.Completed:Connect(function()
			pcall(function() ghost:Destroy() end)
			if label then
				label.TextTransparency = 0
			end
			FavCmds.apply(btn)
			setCmdRowSelected(btn, false)
		end)
	end)
end
