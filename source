--[[
	Infinity Yield Plus 7.63
	Loads the 7.50 core from a pinned commit, then registers placeurl
	in the same player loadstring so the command panel sees addcmd.
]]

local CORE_URL = 'https://raw.githubusercontent.com/nikita104566/Infinity-Yield-Plus/e30e0ec732e718618e723f06a2aedda820ed9e5a/source'

local ok, raw = pcall(function()
	return game:HttpGet(CORE_URL)
end)
if not ok or type(raw) ~= 'string' or raw == '' then
	error('Infinity Yield Plus: failed to fetch core source')
end

raw = string.gsub(raw, "currentVersion = '7.50'", "currentVersion = '7.63'", 1)

raw = string.gsub(
	raw,
	'\tfavHintRemove = "★  Favorited · right-click to remove",\n\t\trefTitle = "Reference",',
	'\tfavHintRemove = "★  Favorited · right-click to remove",\n\t\tplaceUrlTitle = "Place URL",\n\t\tplaceUrlCopied = "Copied the Roblox place link",\n\t\tplaceUrlNoClip = "No clipboard on this executor",\n\t\trefTitle = "Reference",',
	1
)

raw = string.gsub(
	raw,
	'\tfavHintRemove = "★  В избранном · ПКМ — убрать",\n\t\trefTitle = "Справка",',
	'\tfavHintRemove = "★  В избранном · ПКМ — убрать",\n\t\tplaceUrlTitle = "Ссылка на место",\n\t\tplaceUrlCopied = "Ссылка на место скопирована",\n\t\tplaceUrlNoClip = "В этом экзекуторе нет буфера обмена",\n\t\trefTitle = "Справка",',
	1
)

local OLD_CMDS = [[CMDs[#CMDs + 1] = {NAME = 'lastcommand / lastcmd', DESC = 'Executes the previous command used'}]]
local NEW_CMDS = [[CMDs[#CMDs + 1] = {NAME = 'lastcommand / lastcmd', DESC = 'Executes the previous command used'}
CMDs[#CMDs + 1] = {NAME = 'placeurl / gamelink / copyplaceurl', DESC = 'Copies the Roblox URL for this place'}]]
raw = string.gsub(raw, OLD_CMDS, NEW_CMDS, 1)

local OLD_CMD = [[addcmd('lastcommand',{'lastcmd'},function(args, speaker)
    if cmdHistory[1]:sub(1,11) ~= 'lastcommand' and cmdHistory[1]:sub(1,7) ~= 'lastcmd' then
        execCmd(cmdHistory[1])
    end
end)]]

local NEW_CMD = [[addcmd('lastcommand',{'lastcmd'},function(args, speaker)
    if cmdHistory[1]:sub(1,11) ~= 'lastcommand' and cmdHistory[1]:sub(1,7) ~= 'lastcmd' then
        execCmd(cmdHistory[1])
    end
end)

addcmd('placeurl',{'gamelink','copyplaceurl'},function(args, speaker)
    local id = tostring(game.PlaceId)
    local url = 'https://www.roblox.com/games/' .. id
    if everyClipboard then
        toClipboard(url)
        notify(T('placeUrlTitle'), T('placeUrlCopied'))
    else
        notify(T('placeUrlTitle'), T('placeUrlNoClip') .. '\n' .. url)
    end
end)]]

local patched, n = string.gsub(raw, OLD_CMD, NEW_CMD, 1)
if n ~= 1 then
	patched = raw
end

local fn, err = loadstring(patched)
if not fn then
	error('Infinity Yield Plus: core compile failed: ' .. tostring(err))
end
fn()
