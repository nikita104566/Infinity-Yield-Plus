addcmd('cframefly', {'cfly'}, function(args, speaker)
    -- credit to peyton#9148 (apeyton)
    execCmd('untweenfly\\unfly\\unvfly\\uncfly')
    CFing = true
    if args[1] and tonumber(args[1]) then
        CFspeed = tonumber(args[1])
    end

    local char = speaker.Character or speaker.CharacterAdded:Wait()
    local humanoid = char:FindFirstChildOfClass('Humanoid')
    local root = char:WaitForChild("HumanoidRootPart")
    local head = char:WaitForChild("Head")

    humanoid.PlatformStand = true
    root.Anchored = true

    local controlModule
    pcall(function()
        controlModule = require(speaker.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
    end)

    if CFloop then CFloop:Disconnect() end

    CFloop = RunService.Heartbeat:Connect(function(dt)
        if not (char and char.Parent and root and head) then return end

        local cam = workspace.CurrentCamera
        local speed = CFspeed * 50
        local camLook = cam.CFrame.LookVector

        local dir = Vector3.zero
        if controlModule then
            pcall(function()
                dir = controlModule:GetMoveVector()
            end)
        end
        if dir.Magnitude < 0.01 then
            local x, z = 0, 0
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then z -= 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then z += 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then x -= 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then x += 1 end
            if x ~= 0 or z ~= 0 then
                dir = Vector3.new(x, 0, z)
                if dir.Magnitude > 1 then dir = dir.Unit end
            end
        end

        local velocity = Vector3.zero
        if dir.Magnitude > 0 then
            local moveDir = cam.CFrame.RightVector * dir.X - cam.CFrame.LookVector * dir.Z
            if moveDir.Magnitude > 0 then
                velocity = moveDir.Unit * speed * dt
            end
        end

        root.CFrame = root.CFrame + velocity
        head.CFrame = CFrame.new(head.Position, head.Position + camLook)
    end)
end)

