+addcmd('listaliases',{'listalias','showaliases','aliaslist'},function(args, speaker)
+    local rows = {}
+    if type(aliases) == "table" then
+        for i = 1, #aliases do
+            local row = aliases[i]
+            if type(row) == "table" then
+                local a = tostring(row.ALIAS or "")
+                local c = tostring(row.CMD or "")
+                if a ~= "" then
+                    rows[#rows + 1] = a .. " -> " .. c
+                end
+            end
+        end
+    end
+    if #rows == 0 then
+        notify(T("listAliasesTitle"), T("listAliasesEmpty"))
+        return
+    end
+    local maxn = 12
+    local shown = {}
+    for i = 1, math.min(#rows, maxn) do
+        shown[#shown + 1] = rows[i]
+    end
+    if #rows > maxn then
+        shown[#shown + 1] = "+" .. tostring(#rows - maxn)
+    end
+    notify(T("listAliasesTitle") .. " (" .. tostring(#rows) .. ")", table.concat(shown, "\n"))
+end)
