@@ applyUiLanguage
	if Cmdbar then Cmdbar.PlaceholderText = T("command") end
+	updatePrefixChip()
	if Prefix then Prefix.Text = T("prefix") end
@@ PrefixBox handler
+function updatePrefixChip()
+	if not PrefixChip then return end
+	local p = tostring(prefix or "")
+	if p == "" then
+		p = ";"
+	end
+	local n = utf8.len(p)
+	if not n then
+		n = #p
+	end
+	if n > 2 then
+		local cut = 1
+		local seen = 0
+		for i = 1, #p do
+			local c = string.byte(p, i)
+			if c < 128 or c >= 192 then
+				seen = seen + 1
+				if seen == 3 then
+					cut = i
+					break
+				end
+			end
+		end
+		if seen >= 3 then
+			p = string.sub(p, 1, cut - 1)
+		end
+	end
+	PrefixChip.Text = p
+end
+updatePrefixChip()
+
 PrefixBox:GetPropertyChangedSignal("Text"):Connect(function()
     prefix = PrefixBox.Text
     Cmdbar.PlaceholderText = T("command")
+    updatePrefixChip()
     updatesaves()
 end)
