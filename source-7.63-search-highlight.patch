+function highlightCmdNeedle(escaped)
+	local needle = cmdListNeedle
+	if type(needle) ~= "string" or needle == "" or #needle < 1 then
+		return escaped
+	end
+	if #needle > 24 then
+		needle = needle:sub(1, 24)
+	end
+	local low = escaped:lower()
+	local nlow = needle:lower()
+	local at = low:find(nlow, 1, true)
+	if not at then
+		return escaped
+	end
+	local before = escaped:sub(1, at - 1)
+	local mid = escaped:sub(at, at + #needle - 1)
+	local after = escaped:sub(at + #needle)
+	return before .. "<font color=\"#F5D76E\">" .. mid .. "</font>" .. after
+end
 
