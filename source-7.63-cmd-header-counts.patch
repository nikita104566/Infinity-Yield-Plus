+function updateCmdListHeaders(favN, otherN)
+	if favN == nil then
+		favN = (cmdFavHeader and tonumber(cmdFavHeader:GetAttribute("Count"))) or 0
+	end
+	if otherN == nil then
+		otherN = (cmdAllHeader and tonumber(cmdAllHeader:GetAttribute("Count"))) or 0
+	end
+	if cmdFavHeader then
+		cmdFavHeader:SetAttribute("Count", favN)
+		local fmt = T("favoritesCount")
+		if type(fmt) == "string" and string.find(fmt, "%%d", 1, true) then
+			cmdFavHeader.Text = string.format(fmt, favN)
+		else
+			cmdFavHeader.Text = T("favorites")
+		end
+	end
